<Application x:Class="NABeauty.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:NABeauty.App"
             xmlns:v="clr-namespace:NABeauty.App.Vistas"
             xmlns:vm="clr-namespace:NABeauty.Presentacion.ViewModels;assembly=NABeauty.Presentacion"
             Startup="Application_Startup"
             ShutdownMode="OnExplicitShutdown">
    <!--
        Recursos globales del POS de N&A Beauty (misma arquitectura visual que DeskCod).

        TEMAS
          * MergedDictionaries[0] es el tema (Themes/Claro.xaml u Oscuro.xaml). Ese índice es
            contrato: TemaService lo reemplaza en caliente.
          * Todo color se consume con DynamicResource. StaticResource se resuelve una sola vez
            y no se enteraría del cambio de tema.
          * Ningún IValueConverter devuelve colores (no se refrescarían): las insignias usan triggers.
          * Colores tomados del logo: vino #9E1B2A, rosa #F6D5DC y negro #1A1416.

        REGLAS QUE EVITAN BUGS YA VISTOS (AnaMarcolPOS / DeskCod)
          * Toda plantilla usa Margin="{TemplateBinding Padding}" en su ContentPresenter.
          * En un Style, los Setter van juntos y Style.Triggers al final (nunca intercalados: MC3088).
          * NO hay estilo implícito de TextBlock: el color de texto se hereda de la ventana.
          * Los controles nativos fijan Foreground en su estilo de Windows; aquí se les asigna el
            token Texto para que funcionen en modo oscuro.

        TIPOGRAFÍA (la misma de la tienda en línea, incrustada con licencia OFL)
          * Anton: títulos de marca (en mayúsculas, como el encabezado del panel web).
          * DM Sans: todo lo demás, incluidos los montos.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Claro.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ═══════════════ Tipografía ═══════════════ -->
            <FontFamily x:Key="FuenteMarca">pack://application:,,,/Assets/Fuentes/#Anton</FontFamily>
            <FontFamily x:Key="FuenteTitulo">pack://application:,,,/Assets/Fuentes/#DM Sans</FontFamily>
            <FontFamily x:Key="FuenteTexto">pack://application:,,,/Assets/Fuentes/#DM Sans</FontFamily>
            <FontFamily x:Key="FuenteNumeros">pack://application:,,,/Assets/Fuentes/#DM Sans</FontFamily>
            <FontFamily x:Key="Iconos">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <!-- ═══════════════ Conversores ═══════════════ -->
            <BooleanToVisibilityConverter x:Key="BoolVis"/>
            <loc:BoolInvertidoVis x:Key="NoBoolVis"/>
            <loc:NuloVis x:Key="NuloVis"/>
            <loc:Mayusculas x:Key="Mayusculas"/>
            <loc:FotoConverter x:Key="Foto"/>
            <loc:Negar x:Key="Negar"/>
            <loc:ColorHexConverter x:Key="ColorHex"/>

            <!-- ═══════════════ Textos (con clave: nunca implícitos) ═══════════════ -->
            <!-- Título de marca: Anton en mayúsculas (encabezados de pantalla, login) -->
            <Style x:Key="TxtMarca" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FuenteMarca}"/>
                <Setter Property="FontSize" Value="26"/>
                <Setter Property="FontWeight" Value="Normal"/>
            </Style>
            <Style x:Key="TxtTitulo" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FuenteTitulo}"/>
                <Setter Property="FontSize" Value="17"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>
            <Style x:Key="TxtGrande" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FuenteTitulo}"/>
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>
            <Style x:Key="TxtEtiqueta" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="{DynamicResource Texto2}"/>
                <Setter Property="Margin" Value="0,0,0,5"/>
            </Style>
            <Style x:Key="TxtTenue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Foreground" Value="{DynamicResource Texto3}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="TxtKpiEtiqueta" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FuenteTitulo}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource Texto2}"/>
            </Style>
            <Style x:Key="TxtKpiValor" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FuenteNumeros}"/>
                <Setter Property="FontSize" Value="25"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,6,0,4"/>
            </Style>
            <!-- Montos sueltos (detalle de venta, pago, planes) -->
            <Style x:Key="TxtMonto" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FuenteNumeros}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <!-- ═══════════════ Contenedores ═══════════════ -->
            <Style x:Key="Tarjeta" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Superficie}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Linea}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="20"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
            </Style>
            <Style x:Key="Kpi" TargetType="Border" BasedOn="{StaticResource Tarjeta}">
                <Setter Property="Padding" Value="18,16"/>
                <Setter Property="Margin" Value="0,0,14,14"/>
                <Setter Property="MinWidth" Value="200"/>
            </Style>
            <!-- KPI principal: fondo de marca. El texto interno usa DestacadoTexto / DestacadoTexto2 -->
            <Style x:Key="KpiDestacado" TargetType="Border" BasedOn="{StaticResource Kpi}">
                <Setter Property="Background" Value="{DynamicResource DestacadoFondo}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource DestacadoTexto}"/>
            </Style>
            <!-- Ícono en recuadro de marca (encabezado de KPI) -->
            <Style x:Key="IconoKpi" TargetType="Border">
                <Setter Property="Width" Value="34"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Background" Value="{DynamicResource AcentoSuave}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource AcentoTinta}"/>
                <Setter Property="TextElement.FontFamily" Value="{StaticResource Iconos}"/>
                <Setter Property="TextElement.FontSize" Value="15"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
            </Style>
            <Style x:Key="IconoKpiDestacado" TargetType="Border" BasedOn="{StaticResource IconoKpi}">
                <Setter Property="Background" Value="#22FFFFFF"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource MarcaClaro}"/>
            </Style>
            <!-- Panel interno (dentro de una tarjeta): datos de contacto, notas, resúmenes -->
            <Style x:Key="Panel" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Superficie2}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource LineaSuave}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="12,10"/>
            </Style>
            <Style x:Key="Nota" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource AmbarSuave}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AmbarBorde}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Ambar}"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>
            <Style x:Key="Aviso" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource RojoSuave}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource RojoBorde}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Rojo}"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>
            <!-- Separador horizontal -->
            <Style x:Key="Separador" TargetType="Border">
                <Setter Property="Height" Value="1"/>
                <Setter Property="Background" Value="{DynamicResource Linea}"/>
                <Setter Property="Margin" Value="0,12"/>
            </Style>
            <!-- Fila de lista con línea inferior -->
            <Style x:Key="FilaLista" TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource LineaSuave}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="0,8"/>
            </Style>

            <!--
                Insignia de estado. El estado va en Tag; el color sale de triggers con DynamicResource
                (no de un converter) para que cambie con el tema. Un solo lugar para todo el sistema.
            -->
            <Style x:Key="Insignia" TargetType="Border">
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Background" Value="{DynamicResource GrisSuave}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Gris}"/>
                <Setter Property="TextElement.FontSize" Value="11.5"/>
                <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
                <Style.Triggers>
                    <!-- Éxito / al día -->
                    <Trigger Property="Tag" Value="pagado"><Setter Property="Background" Value="{DynamicResource VerdeSuave}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource Verde}"/></Trigger>
                    <Trigger Property="Tag" Value="completado"><Setter Property="Background" Value="{DynamicResource VerdeSuave}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource Verde}"/></Trigger>
                    <Trigger Property="Tag" Value="produccion"><Setter Property="Background" Value="{DynamicResource VerdeSuave}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource Verde}"/></Trigger>
                    <Trigger Property="Tag" Value="convertido"><Setter Property="Background" Value="{DynamicResource VerdeSuave}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource Verde}"/></Trigger>
                    <Trigger Property="Tag" Value="enviado"><Setter Property="Background" Value="{DynamicResource VerdeSuave}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource Verde}"/></Trigger>
                    <Trigger Property="Tag" Value="al_dia"><Setter Property="Background" Value="{DynamicResource VerdeSuave}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource Verde}"/></Trigger>
                    <Trigger Property="Tag" Value="activo"><Setter Property="Background" Value="{DynamicResource VerdeSuave}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource Verde}"/></Trigger>
                    <Trigger Property="Tag" Value="activa"><Setter Property="Background" Value="{DynamicResource VerdeSuave}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource Verde}"/></Trigger>
                    <!-- Atención -->
                    <Trigger Property="Tag" Value="por_vencer"><Setter Property="Background" Value="{DynamicResource AmbarSuave}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource Ambar}"/></Trigger>
                    <Trigger Property="Tag" Value="pendiente_aprobacion"><Setter Property="Background" Value="{DynamicResource AmbarSuave}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource Ambar}"/></Trigger>
                    <Trigger Property="Tag" Value="desarrollo"><Setter Property="Background" Value="{DynamicResource AmbarSuave}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource Ambar}"/></Trigger>
                    <Trigger Property="Tag" Value="nuevo"><Setter Property="Background" Value="{DynamicResource AmbarSuave}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource Ambar}"/></Trigger>
                    <Trigger Property="Tag" Value="contactado"><Setter Property="Background" Value="{DynamicResource AmbarSuave}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource Ambar}"/></Trigger>
                    <Trigger Property="Tag" Value="pendiente"><Setter Property="Background" Value="{DynamicResource AmbarSuave}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource Ambar}"/></Trigger>
                    <!-- Problema -->
                    <Trigger Property="Tag" Value="vencido"><Setter Property="Background" Value="{DynamicResource RojoSuave}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource Rojo}"/></Trigger>
                    <Trigger Property="Tag" Value="rechazado"><Setter Property="Background" Value="{DynamicResource RojoSuave}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource Rojo}"/></Trigger>
                    <Trigger Property="Tag" Value="error"><Setter Property="Background" Value="{DynamicResource RojoSuave}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource Rojo}"/></Trigger>
                    <Trigger Property="Tag" Value="inactivo"><Setter Property="Background" Value="{DynamicResource GrisSuave}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource Gris}"/></Trigger>
                    <!-- POS: ventas e inventario -->
                    <Trigger Property="Tag" Value="completada"><Setter Property="Background" Value="{DynamicResource VerdeSuave}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource Verde}"/></Trigger>
                    <Trigger Property="Tag" Value="anulada"><Setter Property="Background" Value="{DynamicResource RojoSuave}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource Rojo}"/></Trigger>
                    <Trigger Property="Tag" Value="agotado"><Setter Property="Background" Value="{DynamicResource RojoSuave}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource Rojo}"/></Trigger>
                    <Trigger Property="Tag" Value="bajo"><Setter Property="Background" Value="{DynamicResource AmbarSuave}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource Ambar}"/></Trigger>
                    <Trigger Property="Tag" Value="pronto"><Setter Property="Background" Value="{DynamicResource AcentoSuave}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource AcentoTinta}"/></Trigger>
                    <!-- Informativo -->
                    <Trigger Property="Tag" Value="no_exigible"><Setter Property="Background" Value="{DynamicResource AzulSuave}"/><Setter Property="TextElement.Foreground" Value="{DynamicResource Azul}"/></Trigger>
                </Style.Triggers>
            </Style>

            <!-- ═══════════════ Botones ═══════════════ -->
            <!-- Plantilla compartida: el hover/pressed lo decide cada estilo con Style.Triggers -->
            <ControlTemplate x:Key="PlantillaBoton" TargetType="Button">
                <Border x:Name="Fondo" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Fondo" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        <Setter TargetName="Fondo" Property="RenderTransform">
                            <Setter.Value><ScaleTransform ScaleX="0.98" ScaleY="0.98"/></Setter.Value>
                        </Setter>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Fondo" Property="Opacity" Value="0.45"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource Superficie}"/>
                <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource LineaFuerte}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="15,8"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template" Value="{StaticResource PlantillaBoton}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource FilaHover}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource AcentoBorde}"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Acento}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="BtnPrimario" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{DynamicResource Acento}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Acento}"/>
                <Setter Property="Foreground" Value="{DynamicResource SobreAcento}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AcentoHover}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource AcentoHover}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="BtnPeligro" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Foreground" Value="{DynamicResource Rojo}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource RojoBorde}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource RojoSuave}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Rojo}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="BtnChico" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Padding" Value="11,5"/>
                <Setter Property="FontSize" Value="12.5"/>
            </Style>
            <Style x:Key="BtnChicoPrimario" TargetType="Button" BasedOn="{StaticResource BtnPrimario}">
                <Setter Property="Padding" Value="11,5"/>
                <Setter Property="FontSize" Value="12.5"/>
            </Style>
            <Style x:Key="BtnEnlace" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource AcentoTinta}"/>
                <Setter Property="Padding" Value="6,3"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AcentoSuave}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- Botón cuadrado solo con ícono (barra superior) -->
            <Style x:Key="BtnIcono" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource Texto2}"/>
                <Setter Property="Width" Value="38"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="FontFamily" Value="{StaticResource Iconos}"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource FilaHover}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- Botón del menú lateral -->
            <Style x:Key="BtnMenu" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource MenuTexto}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="12,9"/>
                <Setter Property="Margin" Value="0,1"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template" Value="{StaticResource PlantillaBoton}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource MenuHover}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- Fila clicable dentro de una tarjeta (próximos cobros, alertas) -->
            <Style x:Key="BtnFila" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="8,8"/>
                <Setter Property="Margin" Value="0,1"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template" Value="{StaticResource PlantillaBoton}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource FilaHover}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ═══════════════ Entradas ═══════════════ -->
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource Entrada}"/>
                <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource Texto}"/>
                <Setter Property="SelectionBrush" Value="{DynamicResource MarcaClaro}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource LineaFuerte}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="9,6"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Borde" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Borde" Property="BorderBrush" Value="{DynamicResource AcentoBorde}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Borde" Property="BorderBrush" Value="{DynamicResource Acento}"/>
                                    <Setter TargetName="Borde" Property="BorderThickness" Value="1.5"/>
                                </Trigger>
                                <Trigger Property="IsReadOnly" Value="True">
                                    <Setter TargetName="Borde" Property="Background" Value="{DynamicResource Superficie2}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Borde" Property="Opacity" Value="0.55"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="TxtMultilinea" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="AcceptsReturn" Value="True"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="VerticalContentAlignment" Value="Top"/>
                <Setter Property="MinHeight" Value="76"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            </Style>
            <Style TargetType="PasswordBox">
                <Setter Property="Background" Value="{DynamicResource Entrada}"/>
                <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource Texto}"/>
                <Setter Property="SelectionBrush" Value="{DynamicResource MarcaClaro}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource LineaFuerte}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="9,6"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border x:Name="Borde" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Borde" Property="BorderBrush" Value="{DynamicResource AcentoBorde}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Borde" Property="BorderBrush" Value="{DynamicResource Acento}"/>
                                    <Setter TargetName="Borde" Property="BorderThickness" Value="1.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ComboBox completo: el de Windows pinta el botón gris claro aunque se cambie el fondo -->
            <Style x:Key="BotonCombo" TargetType="ToggleButton">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="ClickMode" Value="Press"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent">
                                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Iconos}" FontSize="10"
                                           Foreground="{DynamicResource Texto2}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Background" Value="{DynamicResource Entrada}"/>
                <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource LineaFuerte}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,6,30,6"/>
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border x:Name="Borde" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True"/>
                                <ToggleButton Style="{StaticResource BotonCombo}"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <ContentPresenter x:Name="Contenido" IsHitTestVisible="False" Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="Left"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                                <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Margin="1,1,26,1" Padding="9,5"
                                         BorderThickness="0" Background="Transparent" IsReadOnly="{TemplateBinding IsReadOnly}"/>
                                <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                       IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                                    <Border Background="{DynamicResource Superficie}" BorderBrush="{DynamicResource Linea}" BorderThickness="1"
                                            CornerRadius="6" Margin="0,4,0,0" Padding="4"
                                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                            MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Borde" Property="BorderBrush" Value="{DynamicResource AcentoBorde}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Borde" Property="BorderBrush" Value="{DynamicResource Acento}"/>
                                </Trigger>
                                <Trigger Property="IsDropDownOpen" Value="True">
                                    <Setter TargetName="Borde" Property="BorderBrush" Value="{DynamicResource Acento}"/>
                                </Trigger>
                                <Trigger Property="IsEditable" Value="True">
                                    <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="Contenido" Property="Visibility" Value="Hidden"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Borde" Property="Opacity" Value="0.55"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Texto3}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
                <Setter Property="Padding" Value="9,7"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Fondo" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource FilaHover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Seleccion}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ═══ Calendario (desplegable del DatePicker) ═══
                 El de Windows fija el texto en gris oscuro dentro de su plantilla: ilegible en modo oscuro.
                 Partes obligatorias que CalendarItem busca por nombre: PART_Root, PART_HeaderButton,
                 PART_PreviousButton, PART_NextButton, PART_MonthView (7×7), PART_YearView (4×3), PART_DisabledVisual. -->
            <Style x:Key="BtnCalendario" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template" Value="{StaticResource PlantillaBoton}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource FilaHover}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="DiaCalendario" TargetType="CalendarDayButton">
                <Setter Property="MinWidth" Value="34"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="Margin" Value="1"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CalendarDayButton">
                            <Border x:Name="Fondo" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsInactive" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Texto3}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource FilaHover}"/>
                                </Trigger>
                                <Trigger Property="IsToday" Value="True">
                                    <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource Acento}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource Acento}"/>
                                    <Setter TargetName="Fondo" Property="BorderBrush" Value="{DynamicResource Acento}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource SobreAcento}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                                <Trigger Property="IsBlackedOut" Value="True">
                                    <Setter TargetName="Fondo" Property="Opacity" Value="0.3"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="MesCalendario" TargetType="CalendarButton">
                <Setter Property="MinWidth" Value="56"/>
                <Setter Property="MinHeight" Value="44"/>
                <Setter Property="Margin" Value="2"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CalendarButton">
                            <Border x:Name="Fondo" Background="Transparent" CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsInactive" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Texto3}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource FilaHover}"/>
                                </Trigger>
                                <Trigger Property="HasSelectedDays" Value="True">
                                    <Setter TargetName="Fondo" Property="Background" Value="{DynamicResource AcentoSuave}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AcentoTinta}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="HojaCalendario" TargetType="CalendarItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CalendarItem">
                            <ControlTemplate.Resources>
                                <!-- Encabezado de los días (lu, ma, mi…) -->
                                <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource Texto3}" FontSize="11.5" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,4,0,6"/>
                                </DataTemplate>
                            </ControlTemplate.Resources>
                            <Grid x:Name="PART_Root">
                                <Border Background="{DynamicResource Superficie}" BorderBrush="{DynamicResource Linea}" BorderThickness="1"
                                        CornerRadius="8" Padding="10,8,10,10">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.2" Color="Black"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="PART_PreviousButton" Style="{StaticResource BtnCalendario}"
                                                    Content="&#xE76B;" FontFamily="{StaticResource Iconos}" FontSize="11"/>
                                            <Button x:Name="PART_HeaderButton" Grid.Column="1" Style="{StaticResource BtnCalendario}"
                                                    FontFamily="{StaticResource FuenteTitulo}" FontWeight="SemiBold" FontSize="14"/>
                                            <Button x:Name="PART_NextButton" Grid.Column="2" Style="{StaticResource BtnCalendario}"
                                                    Content="&#xE76C;" FontFamily="{StaticResource Iconos}" FontSize="11"/>
                                        </Grid>
                                        <Grid x:Name="PART_MonthView" Grid.Row="1" Visibility="Visible">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                        </Grid>
                                        <Grid x:Name="PART_YearView" Grid.Row="1" Visibility="Hidden">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Rectangle x:Name="PART_DisabledVisual" Fill="{DynamicResource Superficie}" Opacity="0.6"
                                           RadiusX="8" RadiusY="8" Visibility="Collapsed"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Year">
                                    <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/>
                                    <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Decade">
                                    <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/>
                                    <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="PART_DisabledVisual" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="CalendarioNA" TargetType="Calendar">
                <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
                <Setter Property="FontFamily" Value="{StaticResource FuenteTexto}"/>
                <Setter Property="CalendarItemStyle" Value="{StaticResource HojaCalendario}"/>
                <Setter Property="CalendarDayButtonStyle" Value="{StaticResource DiaCalendario}"/>
                <Setter Property="CalendarButtonStyle" Value="{StaticResource MesCalendario}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Calendar">
                            <!-- Margen: deja ver la sombra dentro del Popup -->
                            <StackPanel x:Name="PART_Root" Margin="6,4,10,12">
                                <CalendarItem x:Name="PART_CalendarItem" Style="{TemplateBinding CalendarItemStyle}"/>
                            </StackPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="Calendar" BasedOn="{StaticResource CalendarioNA}"/>

            <!-- ═══ DatePicker ═══
                 El DatePicker busca por nombre PART_Root, PART_TextBox, PART_Button y PART_Popup;
                 él mismo coloca el Calendar dentro del Popup. -->
            <Style TargetType="DatePickerTextBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource Texto}"/>
                <Setter Property="SelectionBrush" Value="{DynamicResource MarcaClaro}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DatePickerTextBox">
                            <Grid Background="Transparent">
                                <TextBlock x:Name="Pista" Text="dd/mm/aaaa" Foreground="{DynamicResource Texto3}" VerticalAlignment="Center"
                                           Margin="{TemplateBinding Padding}" Visibility="Collapsed" IsHitTestVisible="False"/>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False" VerticalAlignment="Center"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter TargetName="Pista" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="DatePicker">
                <Setter Property="Background" Value="{DynamicResource Entrada}"/>
                <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource LineaFuerte}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="MinWidth" Value="140"/>
                <Setter Property="FontSize" Value="13.5"/>
                <Setter Property="Padding" Value="10,6,4,6"/>
                <Setter Property="IsTodayHighlighted" Value="True"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="CalendarStyle" Value="{StaticResource CalendarioNA}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DatePicker">
                            <Border x:Name="Borde" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                                <Grid x:Name="PART_Root">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <DatePickerTextBox x:Name="PART_TextBox" Padding="{TemplateBinding Padding}"
                                                       Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"/>
                                    <Button x:Name="PART_Button" Grid.Column="1" Style="{StaticResource BtnCalendario}" Margin="0,0,3,0"
                                            Width="32" Height="28" Padding="0" Foreground="{DynamicResource Texto2}"
                                            Content="&#xE787;" FontFamily="{StaticResource Iconos}" FontSize="14" ToolTip="Elegir fecha"/>
                                    <Popup x:Name="PART_Popup" PlacementTarget="{Binding ElementName=Borde}" Placement="Bottom"
                                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Borde" Property="BorderBrush" Value="{DynamicResource AcentoBorde}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Borde" Property="BorderBrush" Value="{DynamicResource Acento}"/>
                                    <Setter TargetName="Borde" Property="BorderThickness" Value="1.5"/>
                                </Trigger>
                                <Trigger Property="IsDropDownOpen" Value="True">
                                    <Setter TargetName="Borde" Property="BorderBrush" Value="{DynamicResource Acento}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Borde" Property="Opacity" Value="0.55"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- CheckBox / RadioButton propios (los de Windows quedan blancos en modo oscuro) -->
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
                <Setter Property="Margin" Value="0,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="Caja" Width="18" Height="18" CornerRadius="4" BorderThickness="1.5" Margin="0,1,0,0"
                                        Background="{DynamicResource Entrada}" BorderBrush="{DynamicResource LineaFuerte}" VerticalAlignment="Top">
                                    <TextBlock x:Name="Marca" Text="&#xE73E;" FontFamily="{StaticResource Iconos}" FontSize="11"
                                               Foreground="{DynamicResource SobreAcento}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Caja" Property="BorderBrush" Value="{DynamicResource Acento}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Caja" Property="Background" Value="{DynamicResource Acento}"/>
                                    <Setter TargetName="Caja" Property="BorderBrush" Value="{DynamicResource Acento}"/>
                                    <Setter TargetName="Marca" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Casilla de solo lectura dentro de una tabla (DataGridCheckBoxColumn.ElementStyle) -->
            <Style x:Key="CeldaCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="IsHitTestVisible" Value="False"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
                <Setter Property="Margin" Value="0,0,16,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Grid Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,0,0">
                                    <Ellipse x:Name="Aro" StrokeThickness="1.5" Fill="{DynamicResource Entrada}" Stroke="{DynamicResource LineaFuerte}"/>
                                    <Ellipse x:Name="Punto" Width="8" Height="8" Fill="{DynamicResource Acento}" Visibility="Collapsed"/>
                                </Grid>
                                <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Aro" Property="Stroke" Value="{DynamicResource Acento}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Aro" Property="Stroke" Value="{DynamicResource Acento}"/>
                                    <Setter TargetName="Punto" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="Expander">
                <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
            </Style>
            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="{DynamicResource Texto}"/>
                <Setter Property="Foreground" Value="{DynamicResource Fondo}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="9,5"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Campo de formulario: etiqueta arriba + control -->
            <Style x:Key="Campo" TargetType="StackPanel">
                <Setter Property="Margin" Value="0,0,14,14"/>
            </Style>

            <!-- Barra de progreso de pago -->
            <Style TargetType="ProgressBar">
                <Setter Property="Height" Value="7"/>
                <Setter Property="Minimum" Value="0"/>
                <Setter Property="Maximum" Value="100"/>
                <Setter Property="Background" Value="{DynamicResource Pista}"/>
                <Setter Property="Foreground" Value="{DynamicResource GradienteProgreso}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3.5"/>
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3.5" Background="{TemplateBinding Foreground}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Barras de desplazamiento delgadas (las de Windows son grises claras incluso en oscuro) -->
            <Style x:Key="PulgarScroll" TargetType="Thumb">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border x:Name="Pulgar" Background="{DynamicResource Barra}" CornerRadius="4"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Pulgar" Property="Background" Value="{DynamicResource BarraHover}"/>
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="Pulgar" Property="Background" Value="{DynamicResource BarraHover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="RepeticionScroll" TargetType="RepeatButton">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Width" Value="10"/>
                <Setter Property="MinWidth" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource RepeticionScroll}" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource PulgarScroll}" MinHeight="24"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource RepeticionScroll}" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="Height" Value="10"/>
                        <Setter Property="MinHeight" Value="10"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="2">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource RepeticionScroll}" Command="ScrollBar.PageLeftCommand"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource PulgarScroll}" MinWidth="24"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource RepeticionScroll}" Command="ScrollBar.PageRightCommand"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ═══════════════ Tablas ═══════════════ -->
            <Style TargetType="DataGrid">
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="CanUserResizeRows" Value="False"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource LineaSuave}"/>
                <Setter Property="Background" Value="{DynamicResource Superficie}"/>
                <Setter Property="RowBackground" Value="{DynamicResource Superficie}"/>
                <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="RowHeight" Value="42"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            </Style>
            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{DynamicResource Superficie2}"/>
                <Setter Property="Foreground" Value="{DynamicResource Texto3}"/>
                <Setter Property="FontFamily" Value="{StaticResource FuenteTitulo}"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="12,9"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Linea}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridColumnHeader">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="DataGridCell">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="DataGridRow">
                <Setter Property="Background" Value="{DynamicResource Superficie}"/>
                <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource FilaHover}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Seleccion}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- Tabla dentro de una pantalla con scroll: crece con su contenido y deja pasar la rueda -->
            <Style x:Key="TablaDetalle" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="loc:Comportamientos.PasarRueda" Value="True"/>
            </Style>
            <!-- Texto de celda alineado a la derecha (montos, en fuente de cifras) -->
            <Style x:Key="CeldaNum" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontFamily" Value="{StaticResource FuenteNumeros}"/>
            </Style>
            <Style x:Key="CeldaTexto" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

            <!-- ═══════════════ Catálogo y caja ═══════════════ -->
            <!--
                Miniatura de producto: Content = archivo de la foto (o ruta si aún no se sube).
                Siempre pequeña (la decodificación se limita en FotoConverter). Sin foto: ícono de imagen.
                El tamaño lo pone quien la usa (Width/Height); por defecto 40×40.
            -->
            <Style x:Key="Miniatura" TargetType="ContentControl">
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <Border Background="{DynamicResource Superficie2}" BorderBrush="{DynamicResource LineaSuave}" BorderThickness="1"
                                    CornerRadius="6" SnapsToDevicePixels="True">
                                <Grid>
                                    <TextBlock Text="&#xE91B;" FontFamily="{StaticResource Iconos}" FontSize="13" Foreground="{DynamicResource Texto3}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border CornerRadius="5">
                                        <Border.Background>
                                            <ImageBrush Stretch="UniformToFill"
                                                        ImageSource="{Binding Content, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Foto}, ConverterParameter=128}"/>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Punto de color (categoría o tono). Tag = "#RRGGBB" -->
            <Style x:Key="PuntoColor" TargetType="Border">
                <Setter Property="Width" Value="12"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource LineaFuerte}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource Self}, Converter={StaticResource ColorHex}}"/>
            </Style>

            <!-- Pestaña / filtro tipo píldora (caja). El estado activo lo pone un DataTrigger de la plantilla -->
            <Style x:Key="BtnChip" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Padding" Value="13,6"/>
                <Setter Property="Margin" Value="0,0,8,8"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Fondo" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" SnapsToDevicePixels="True">
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Fondo" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Tarjeta de producto en la caja (botón grande, toda la tarjeta es clicable) -->
            <Style x:Key="BtnArticulo" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource Superficie}"/>
                <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Linea}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10"/>
                <Setter Property="Margin" Value="0,0,10,10"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Fondo" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Fondo" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                    <Setter TargetName="Fondo" Property="RenderTransform">
                                        <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource AcentoBorde}"/>
                        <Setter Property="Background" Value="{DynamicResource FilaHover}"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Acento}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Fila seleccionable de una lista (categorías, productos) -->
            <Style x:Key="ItemLista" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="12,9"/>
                <Setter Property="Margin" Value="0,0,0,2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource FilaHover}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Seleccion}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="Lista" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Foreground" Value="{DynamicResource Texto}"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource ItemLista}"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            </Style>

            <!-- Encabezado de sección dentro de una tarjeta -->
            <Style x:Key="TxtSeccion" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource FuenteTitulo}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <!-- Tarjeta de indicador: Destacado = fondo vino (Inicio y Reportes) -->
            <DataTemplate x:Key="PlantillaKpi">
                <Border x:Name="Tarjeta" Style="{StaticResource Kpi}" Margin="0,0,14,14" MinWidth="0">
                    <StackPanel>
                        <DockPanel>
                            <Border x:Name="Ico" DockPanel.Dock="Right" Style="{StaticResource IconoKpi}">
                                <TextBlock Text="{Binding Icono}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="Etiqueta" Text="{Binding Titulo}" Style="{StaticResource TxtKpiEtiqueta}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Valor}" Style="{StaticResource TxtKpiValor}"/>
                        <TextBlock x:Name="Detalle" Text="{Binding Detalle}" Style="{StaticResource TxtTenue}"/>
                        <!-- Comparación con el período anterior: flecha + texto (nunca solo color) -->
                        <StackPanel x:Name="Var" Orientation="Horizontal" Margin="0,6,0,0"
                                    Visibility="{Binding HayVariacion, Converter={StaticResource BoolVis}}">
                            <TextBlock x:Name="Flecha" Text="&#xE76C;" FontFamily="{StaticResource Iconos}" FontSize="10"
                                       VerticalAlignment="Center" Margin="0,0,5,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="VarTexto" Text="{Binding Variacion}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Texto3}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Tendencia}" Value="sube">
                        <Setter TargetName="Flecha" Property="Text" Value="&#xE70E;"/>
                        <Setter TargetName="Flecha" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="Flecha" Property="Foreground" Value="{DynamicResource Verde}"/>
                        <Setter TargetName="VarTexto" Property="Foreground" Value="{DynamicResource Verde}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tendencia}" Value="baja">
                        <Setter TargetName="Flecha" Property="Text" Value="&#xE70D;"/>
                        <Setter TargetName="Flecha" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="Flecha" Property="Foreground" Value="{DynamicResource Rojo}"/>
                        <Setter TargetName="VarTexto" Property="Foreground" Value="{DynamicResource Rojo}"/>
                    </DataTrigger>
                    <!-- Destacada: fondo vino, textos claros. Va al final para mandar sobre la tendencia -->
                    <DataTrigger Binding="{Binding Destacado}" Value="True">
                        <Setter TargetName="Tarjeta" Property="Style" Value="{StaticResource KpiDestacado}"/>
                        <Setter TargetName="Ico" Property="Style" Value="{StaticResource IconoKpiDestacado}"/>
                        <Setter TargetName="Etiqueta" Property="Foreground" Value="{DynamicResource DestacadoTexto2}"/>
                        <Setter TargetName="Detalle" Property="Foreground" Value="{DynamicResource DestacadoTexto2}"/>
                        <Setter TargetName="VarTexto" Property="Foreground" Value="{DynamicResource DestacadoTexto}"/>
                        <Setter TargetName="Flecha" Property="Foreground" Value="{DynamicResource DestacadoTexto}"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- ═══════════════ Vista por ViewModel ═══════════════ -->
            <DataTemplate DataType="{x:Type vm:InicioViewModel}"><v:InicioView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:CategoriasViewModel}"><v:CategoriasView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProductosViewModel}"><v:ProductosView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProductoEditorViewModel}"><v:ProductoEditorView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:CajaViewModel}"><v:CajaView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:VentasViewModel}"><v:VentasView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:EntradasViewModel}"><v:EntradasView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:NuevaEntradaViewModel}"><v:NuevaEntradaView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReportesViewModel}"><v:ReportesView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:UsuariosViewModel}"><v:UsuariosView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:RolesViewModel}"><v:RolesView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:AjustesViewModel}"><v:AjustesView/></DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>
