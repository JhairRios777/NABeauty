<Window x:Class="NABeauty.App.Ventanas.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:NABeauty.App.Controles"
        Title="N&amp;A Beauty POS — Iniciar sesión" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="{DynamicResource Texto}" FontFamily="{StaticResource FuenteTexto}" FontSize="13.5"
        Icon="pack://application:,,,/Assets/NABeauty.ico"
        PreviewKeyDown="Window_PreviewKeyDown" Activated="Window_Activated">
    <!--
        Login compacto como el de AnaMarcolPOS: tarjeta flotante sin barra de título,
        con los colores del logo de N&A Beauty en modo claro y oscuro.
        Sin barra de título, el arrastre y el cierre se resuelven aquí (si no, solo Alt+F4).
    -->
    <Border Margin="18" Background="{DynamicResource Superficie}" CornerRadius="14"
            BorderBrush="{DynamicResource Linea}" BorderThickness="1"
            MouseLeftButtonDown="Ventana_Arrastrar">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.35" BlurRadius="24" ShadowDepth="5" Direction="270"/>
        </Border.Effect>

        <Grid>
            <!-- Franja vino superior: la marca -->
            <Border Height="6" VerticalAlignment="Top" CornerRadius="14,14,0,0" Background="{DynamicResource PanelMarca}"/>

            <StackPanel>
                <!-- ── Barra superior: tema y cerrar ── -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,10,0">
                    <Button Style="{StaticResource BtnIcono}" Width="32" Height="32" FontSize="13"
                            Content="{DynamicResource IconoTema}" ToolTip="{DynamicResource TextoTema}" Click="Tema_Click"/>
                    <Button Style="{StaticResource BtnIcono}" Width="32" Height="32" FontSize="10"
                            Content="&#xE8BB;" ToolTip="Cerrar" Click="Cerrar_Click"/>
                </StackPanel>

                <StackPanel Margin="34,0,34,30">
                    <!-- ── Identidad del negocio ── -->
                    <Image Source="{DynamicResource LogoSuperficie}" Height="86" Stretch="Uniform"
                           HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>

                    <!-- Deja claro en qué sistema está la cajera: este es el local, no el panel web -->
                    <TextBlock Text="PUNTO DE VENTA · MODO LOCAL" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Texto3}" HorizontalAlignment="Center" Margin="0,12,0,26"/>

                    <!-- ── Usuario ── -->
                    <TextBlock Text="Usuario" Style="{StaticResource TxtEtiqueta}"/>
                    <Grid Margin="0,0,0,14">
                        <TextBox x:Name="TxtUsuario" Text="{Binding Usuario, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="36,8,12,8" MinHeight="42"/>
                        <TextBlock Text="&#xE77B;" FontFamily="{StaticResource Iconos}" Foreground="{DynamicResource Texto3}"
                                   IsHitTestVisible="False" VerticalAlignment="Center" Margin="13,0,0,0"/>
                    </Grid>

                    <!-- ── Contraseña con ojo ── -->
                    <TextBlock Text="Contraseña" Style="{StaticResource TxtEtiqueta}"/>
                    <Grid>
                        <c:CampoClave x:Name="TxtClave" KeyDown="TxtClave_KeyDown" Relleno="36,8,42,8" MinHeight="42"/>
                        <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Iconos}" Foreground="{DynamicResource Texto3}"
                                   IsHitTestVisible="False" VerticalAlignment="Center" Margin="13,0,0,0"/>
                    </Grid>

                    <!-- ── Bloq Mayús: causa #1 de "mi contraseña no sirve" en una caja ── -->
                    <StackPanel x:Name="AvisoMayus" Orientation="Horizontal" Margin="2,8,0,0" Visibility="Collapsed">
                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Iconos}" FontSize="11"
                                   Foreground="{DynamicResource Ambar}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Bloq Mayús está activado" FontSize="12" Foreground="{DynamicResource Ambar}"/>
                    </StackPanel>

                    <!-- ── Error ── -->
                    <Border Style="{StaticResource Aviso}" Margin="0,14,0,0" Visibility="{Binding HayError, Converter={StaticResource BoolVis}}">
                        <DockPanel>
                            <TextBlock Text="&#xE783;" FontFamily="{StaticResource Iconos}" Margin="0,2,9,0" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" FontSize="12.5"/>
                        </DockPanel>
                    </Border>

                    <!-- ── Entrar: ancho completo ── -->
                    <Button Style="{StaticResource BtnPrimario}" Margin="0,22,0,0" Padding="14,12" Click="Entrar_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Entrar" FontSize="14.5"/>
                            <TextBlock Text="&#xE72A;" FontFamily="{StaticResource Iconos}" FontSize="13" Margin="10,1,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="La caja funciona sin internet. La sincronización con la tienda en línea es automática."
                               Style="{StaticResource TxtTenue}" FontSize="11.5" TextAlignment="Center" Margin="0,18,0,0"/>
                    <TextBlock Text="Tras 5 intentos fallidos el usuario se bloquea 15 minutos."
                               Style="{StaticResource TxtTenue}" FontSize="11.5" TextAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
