<Window x:Class="NABeauty.App.Ventanas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="N&amp;A Beauty POS" Width="1360" Height="860" MinWidth="1040" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{DynamicResource Fondo}" Foreground="{DynamicResource Texto}"
        FontFamily="{StaticResource FuenteTexto}" FontSize="13.5"
        Icon="pack://application:,,,/Assets/NABeauty.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═════════ Menú lateral (vino en claro, negro del logo en oscuro) ═════════ -->
        <Border Grid.Column="0" Background="{DynamicResource MenuFondo}" BorderBrush="{DynamicResource MenuBorde}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <!-- Logo -->
                <Border DockPanel.Dock="Top" Padding="22,22,22,14">
                    <StackPanel>
                        <Image Source="{DynamicResource LogoMenu}" Height="62" HorizontalAlignment="Left"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="PUNTO DE VENTA" Foreground="{DynamicResource MenuGrupo}" FontSize="10.5"
                                   FontWeight="SemiBold" Margin="2,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Usuario y sesión (abajo) -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource MenuSeparador}" BorderThickness="0,1,0,0" Padding="12,12,12,14">
                    <StackPanel>
                        <Grid Margin="6,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource MarcaClaro}">
                                <TextBlock Text="{Binding Iniciales}" Foreground="#7A1220" FontWeight="Bold" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding NombreUsuario}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding RolUsuario}" Foreground="{DynamicResource MenuGrupo}" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                        <Button Style="{StaticResource BtnMenu}" Click="CambiarClave_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Iconos}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                <TextBlock Text="Cambiar contraseña" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BtnMenu}" Click="CerrarSesion_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xF3B1;" FontFamily="{StaticResource Iconos}" FontSize="14" Width="28" VerticalAlignment="Center"/>
                                <TextBlock Text="Cerrar sesión" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Opciones según permisos, agrupadas -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,0">
                    <ItemsControl ItemsSource="{Binding Grupos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Nombre}" Foreground="{DynamicResource MenuGrupo}"
                                               FontSize="11" FontWeight="SemiBold" Margin="12,12,0,5"/>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button x:Name="Opcion" Style="{StaticResource BtnMenu}" HorizontalContentAlignment="Stretch"
                                                        Command="{Binding DataContext.IrACommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Clave}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="28"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="Icono" Text="{Binding Icono}" FontFamily="{StaticResource Iconos}" FontSize="15"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="Texto" Grid.Column="1" Text="{Binding Texto}" VerticalAlignment="Center"/>
                                                        <!-- Módulo en construcción -->
                                                        <Border x:Name="Pronto" Grid.Column="2" CornerRadius="8" Padding="7,1" Margin="8,0,0,0"
                                                                Background="{DynamicResource MenuHover}" VerticalAlignment="Center"
                                                                Visibility="{Binding Proximamente, Converter={StaticResource BoolVis}}">
                                                            <TextBlock x:Name="ProntoTexto" Text="Pronto" FontSize="10.5" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource MenuGrupo}"/>
                                                        </Border>
                                                    </Grid>
                                                </Button>
                                                <!-- Opción activa: fondo resaltado y texto en negrita (como el panel web) -->
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Activo}" Value="True">
                                                        <Setter TargetName="Opcion" Property="Background" Value="{DynamicResource MenuActivo}"/>
                                                        <Setter TargetName="Opcion" Property="Foreground" Value="{DynamicResource MenuActivoTexto}"/>
                                                        <Setter TargetName="Texto" Property="FontWeight" Value="SemiBold"/>
                                                        <Setter TargetName="Pronto" Property="Background" Value="{DynamicResource AcentoSuave}"/>
                                                        <Setter TargetName="ProntoTexto" Property="Foreground" Value="{DynamicResource AcentoTinta}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ═════════ Barra superior + contenido ═════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="76"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{DynamicResource Linea}" BorderThickness="0,0,0,1" Background="{DynamicResource Fondo}">
                <Grid Margin="28,0,22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource BtnIcono}" Command="{Binding VolverCommand}" Margin="-8,0,10,0"
                            ToolTip="Volver" Content="&#xE72B;"
                            Visibility="{Binding PuedeVolver, Converter={StaticResource BoolVis}}"/>

                    <!-- Título en Anton mayúsculas, como el encabezado del panel web -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Titulo, Converter={StaticResource Mayusculas}}" Style="{StaticResource TxtMarca}"
                                   FontSize="27" Foreground="{DynamicResource AcentoTinta}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Foreground="{DynamicResource Texto3}" FontSize="12" Margin="1,1,0,0">
                            <TextBlock.Text>
                                <Binding Source="{x:Static sys:DateTime.Today}" StringFormat="{}{0:dddd, d 'de' MMMM 'de' yyyy}" ConverterCulture="es-HN"/>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource BtnIcono}" Click="Refrescar_Click" Margin="0,0,4,0"
                                ToolTip="Actualizar los datos" Content="&#xE72C;"/>
                        <Button Style="{StaticResource BtnIcono}" Click="Tema_Click"
                                ToolTip="{DynamicResource TextoTema}" Content="{DynamicResource IconoTema}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Pantalla actual: App.xaml elige la vista según el tipo de ViewModel -->
            <ContentControl Grid.Row="1" Content="{Binding Vista}" Focusable="False"/>
        </Grid>
    </Grid>
</Window>
