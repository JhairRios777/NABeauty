<Window x:Class="NABeauty.App.Ventanas.CambiarClaveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:NABeauty.App.Controles"
        Title="N&amp;A Beauty POS — Cambiar contraseña" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource Superficie}" Foreground="{DynamicResource Texto}"
        FontFamily="{StaticResource FuenteTexto}" FontSize="13.5"
        Icon="pack://application:,,,/Assets/NABeauty.ico">
    <StackPanel>
        <!-- Encabezado con la marca -->
        <Border Background="{DynamicResource PanelMarca}" Padding="28,20">
            <DockPanel>
                <Image DockPanel.Dock="Right" Source="{DynamicResource LogoMenu}" Height="46" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel>
                    <TextBlock Text="CAMBIAR CONTRASEÑA" Style="{StaticResource TxtMarca}" FontSize="24" Foreground="White"/>
                    <TextBlock Text="Protege el acceso a tus ventas e inventario." Foreground="{DynamicResource DestacadoTexto2}" FontSize="12.5" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel Margin="28,22,28,26">
            <Border Style="{StaticResource Nota}" Visibility="{Binding Obligatorio, Converter={StaticResource BoolVis}}">
                <TextBlock Text="Tu contraseña es temporal. Crea una propia para continuar." TextWrapping="Wrap"/>
            </Border>
            <Border Style="{StaticResource Aviso}" Visibility="{Binding HayError, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap"/>
            </Border>

            <TextBlock Text="Contraseña actual" Style="{StaticResource TxtEtiqueta}"/>
            <c:CampoClave x:Name="Actual" Margin="0,0,0,14"/>
            <TextBlock Text="Nueva contraseña" Style="{StaticResource TxtEtiqueta}"/>
            <c:CampoClave x:Name="Nueva" Margin="0,0,0,5"/>
            <TextBlock Text="Mínimo 10 caracteres, con letras y números." Style="{StaticResource TxtTenue}" Margin="0,0,0,14"/>
            <TextBlock Text="Repite la nueva contraseña" Style="{StaticResource TxtEtiqueta}"/>
            <c:CampoClave x:Name="Repetida" Margin="0,0,0,22"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" IsCancel="True"/>
                <Button Content="Guardar contraseña" Style="{StaticResource BtnPrimario}" Margin="0" Click="Guardar_Click"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>
