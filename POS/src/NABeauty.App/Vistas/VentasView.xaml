<UserControl x:Class="NABeauty.App.Vistas.VentasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NABeauty.App.Controles">
    <!--
        Historial de ventas: filtros, totales del filtro, tabla y detalle de la venta elegida
        (líneas, pago, recibo y anulación con motivo).
    -->
    <DockPanel Margin="28,20,28,22">

        <!-- ── Filtros ── -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <c:SelectorPeriodoView DataContext="{Binding Periodo}" Margin="0,0,10,8"/>
            <ComboBox Width="160" Margin="0,0,10,8" ItemsSource="{Binding Metodos}" SelectedItem="{Binding Metodo}"/>
            <ComboBox Width="190" Margin="0,0,10,8" ItemsSource="{Binding Vendedoras}" SelectedItem="{Binding Vendedora}"/>
            <ComboBox Width="140" Margin="0,0,10,8" ItemsSource="{Binding OpcionesEstado}" SelectedItem="{Binding Estado}"/>
            <Grid Width="170" Margin="0,0,0,8">
                <TextBox Text="{Binding Numero, UpdateSourceTrigger=PropertyChanged, Delay=250}" Padding="32,6,9,6"/>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource Iconos}" FontSize="12" Foreground="{DynamicResource Texto3}"
                           VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False"/>
                <TextBlock Text="N.º de venta" Foreground="{DynamicResource Texto3}" VerticalAlignment="Center" Margin="33,0,0,0" IsHitTestVisible="False"
                           Visibility="{Binding Numero, Converter={StaticResource NuloVis}, ConverterParameter=inv}"/>
            </Grid>
        </WrapPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="440"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- ── Lista ── -->
            <Border Style="{StaticResource Tarjeta}" Margin="0" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="18,14" BorderBrush="{DynamicResource Linea}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding TotalTexto}" FontFamily="{StaticResource FuenteNumeros}" FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource AcentoTinta}" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="{Binding ResumenTexto}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding AnuladasTexto}" Foreground="{DynamicResource Rojo}" FontSize="12.5"
                                           Visibility="{Binding HayAnuladas, Converter={StaticResource BoolVis}}"/>
                                <TextBlock Text="Se muestran las 500 más recientes: ajusta los filtros para ver el resto." Style="{StaticResource TxtTenue}"
                                           Visibility="{Binding Recortado, Converter={StaticResource BoolVis}}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <StackPanel DockPanel.Dock="Top" Margin="24,48" HorizontalAlignment="Center"
                                Visibility="{Binding HayVentas, Converter={StaticResource NoBoolVis}}">
                        <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource Iconos}" FontSize="30" Foreground="{DynamicResource Texto3}" HorizontalAlignment="Center"/>
                        <TextBlock Text="No hay ventas con estos filtros." Foreground="{DynamicResource Texto2}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Lista}" SelectedItem="{Binding Seleccionada}" RowHeight="46"
                              Visibility="{Binding HayVentas, Converter={StaticResource BoolVis}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="VENTA" Binding="{Binding Numero}" Width="100" ElementStyle="{StaticResource CeldaTexto}"/>
                            <DataGridTextColumn Header="FECHA" Binding="{Binding FechaTexto}" Width="130" ElementStyle="{StaticResource CeldaTexto}"/>
                            <DataGridTextColumn Header="VENDEDORA" Binding="{Binding Vendedora}" Width="*" ElementStyle="{StaticResource CeldaTexto}"/>
                            <DataGridTextColumn Header="PAGO" Binding="{Binding Metodo}" Width="110" ElementStyle="{StaticResource CeldaTexto}"/>
                            <DataGridTextColumn Header="ARTÍCULOS" Binding="{Binding Unidades}" Width="80" ElementStyle="{StaticResource CeldaNum}"/>
                            <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalTexto}" Width="110" ElementStyle="{StaticResource CeldaNum}"/>
                            <DataGridTemplateColumn Header="ESTADO" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Insignia}" Tag="{Binding Estado}" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding EstadoTexto}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- ── Detalle ── -->
            <Border Grid.Column="2" Style="{StaticResource Tarjeta}" Margin="0" Padding="0">
                <Grid>
                    <StackPanel Margin="24,60" HorizontalAlignment="Center" Visibility="{Binding HaySeleccion, Converter={StaticResource NoBoolVis}}">
                        <TextBlock Text="&#xE8A1;" FontFamily="{StaticResource Iconos}" FontSize="28" Foreground="{DynamicResource Texto3}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Elige una venta para ver su detalle." Foreground="{DynamicResource Texto2}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <DockPanel Visibility="{Binding HaySeleccion, Converter={StaticResource BoolVis}}">
                        <Border DockPanel.Dock="Top" Padding="18,14" BorderBrush="{DynamicResource Linea}" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource Insignia}" Tag="{Binding Seleccionada.Estado}">
                                    <TextBlock Text="{Binding Seleccionada.EstadoTexto}"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{Binding Seleccionada.Numero}" Style="{StaticResource TxtMarca}" FontSize="22" Foreground="{DynamicResource AcentoTinta}"/>
                                    <TextBlock Style="{StaticResource TxtTenue}">
                                        <Run Text="{Binding Seleccionada.FechaTexto, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Seleccionada.Vendedora, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Acciones -->
                        <Border DockPanel.Dock="Bottom" Padding="18,14" BorderBrush="{DynamicResource Linea}" BorderThickness="0,1,0,0" Background="{DynamicResource Superficie2}"
                                CornerRadius="0,0,8,8">
                            <StackPanel>
                                <Button Command="{Binding ImprimirCommand}" Margin="0" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE749;" FontFamily="{StaticResource Iconos}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Imprimir recibo"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel Margin="0,14,0,0" Visibility="{Binding PuedeAnular, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="Motivo de la anulación" Style="{StaticResource TxtEtiqueta}"/>
                                    <TextBox Text="{Binding Motivo, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"/>
                                    <Button Style="{StaticResource BtnPeligro}" Content="Anular venta" Command="{Binding AnularCommand}" Margin="0,8,0,0" HorizontalAlignment="Stretch"/>
                                    <TextBlock Text="El stock de sus productos regresa al inventario." Style="{StaticResource TxtTenue}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="18,8,18,14">
                                <!-- Anulada: quién, cuándo y por qué -->
                                <Border Background="{DynamicResource RojoSuave}" CornerRadius="6" Padding="12,9" Margin="0,6,0,6"
                                        Visibility="{Binding DetalleAnulacion, Converter={StaticResource NuloVis}}">
                                    <TextBlock Text="{Binding DetalleAnulacion}" Foreground="{DynamicResource Rojo}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Lineas}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource FilaLista}">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SubtotalTexto}" Style="{StaticResource TxtMonto}" VerticalAlignment="Center"/>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                        <TextBlock Style="{StaticResource TxtTenue}">
                                                            <Run Text="{Binding Cantidad, Mode=OneWay}"/><Run Text=" × "/><Run Text="{Binding PrecioTexto, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <DockPanel Margin="0,12,0,0">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding DetalleSubtotal}" Style="{StaticResource TxtMonto}"/>
                                    <TextBlock Text="Subtotal" Foreground="{DynamicResource Texto2}"/>
                                </DockPanel>
                                <DockPanel Margin="0,4,0,0" Visibility="{Binding DetalleHayDescuento, Converter={StaticResource BoolVis}}">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding DetalleDescuento}" Style="{StaticResource TxtMonto}" Foreground="{DynamicResource Verde}"/>
                                    <TextBlock Text="Descuento" Foreground="{DynamicResource Texto2}"/>
                                </DockPanel>
                                <DockPanel Margin="0,8,0,4">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding DetalleTotal}" FontFamily="{StaticResource FuenteNumeros}" FontSize="22" FontWeight="Bold"
                                               Foreground="{DynamicResource AcentoTinta}"/>
                                    <TextBlock Text="TOTAL" Style="{StaticResource TxtMarca}" FontSize="19" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Text="{Binding DetallePago}" Style="{StaticResource TxtTenue}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
