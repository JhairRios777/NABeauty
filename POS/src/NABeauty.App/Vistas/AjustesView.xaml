<UserControl x:Class="NABeauty.App.Vistas.AjustesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Ajustes en tarjetas: negocio y recibo, seguridad del ingreso, tienda en línea y respaldos. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,22,28,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═════════ Izquierda ═════════ -->
            <StackPanel>
                <Border Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <TextBlock Text="Negocio y recibo" Style="{StaticResource TxtTitulo}"/>
                        <StackPanel Style="{StaticResource Campo}" Margin="0,0,0,12">
                            <TextBlock Text="Nombre del negocio" Style="{StaticResource TxtEtiqueta}"/>
                            <TextBox Text="{Binding NegocioNombre, UpdateSourceTrigger=PropertyChanged}" MaxLength="80"/>
                        </StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="RTN (opcional)" Style="{StaticResource TxtEtiqueta}"/>
                                <TextBox Text="{Binding Rtn, UpdateSourceTrigger=PropertyChanged}" MaxLength="20"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Teléfono (opcional)" Style="{StaticResource TxtEtiqueta}"/>
                                <TextBox Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}" MaxLength="20"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Style="{StaticResource Campo}" Margin="0,0,0,12">
                            <TextBlock Text="Dirección (opcional)" Style="{StaticResource TxtEtiqueta}"/>
                            <TextBox Text="{Binding Direccion, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Campo}" Margin="0,0,0,12">
                            <TextBlock Text="Mensaje al pie del recibo" Style="{StaticResource TxtEtiqueta}"/>
                            <TextBox Text="{Binding MensajeRecibo, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"/>
                        </StackPanel>
                        <TextBlock Text="Papel de la impresora de recibos" Style="{StaticResource TxtEtiqueta}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                            <RadioButton GroupName="Papel" IsChecked="{Binding Papel80}" Content="80 mm"/>
                            <RadioButton GroupName="Papel" IsChecked="{Binding Papel58}" Content="58 mm"/>
                        </StackPanel>
                        <CheckBox IsChecked="{Binding ImprimirAlCobrar}" Margin="0,0,0,14">
                            <TextBlock Text="Imprimir el recibo automáticamente al cobrar (impresora predeterminada)" TextWrapping="Wrap"/>
                        </CheckBox>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource BtnPrimario}" Content="Guardar" Command="{Binding GuardarNegocioCommand}"/>
                            <Button Content="Imprimir recibo de prueba" Command="{Binding PruebaReciboCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <TextBlock Text="Seguridad del ingreso" Style="{StaticResource TxtTitulo}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Intentos fallidos permitidos (3 a 20)" Style="{StaticResource TxtEtiqueta}"/>
                                <TextBox Text="{Binding Intentos, UpdateSourceTrigger=PropertyChanged}" MaxLength="2"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Minutos de bloqueo (1 a 1440)" Style="{StaticResource TxtEtiqueta}"/>
                                <TextBox Text="{Binding Minutos, UpdateSourceTrigger=PropertyChanged}" MaxLength="4"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Aplica al POS. Un administrador puede desbloquear antes desde Usuarios." Style="{StaticResource TxtTenue}" Margin="0,0,0,12"/>
                        <Button Style="{StaticResource BtnPrimario}" Content="Guardar" Command="{Binding GuardarSeguridadCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ═════════ Derecha ═════════ -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <TextBlock Text="Tienda en línea" Style="{StaticResource TxtTitulo}"/>
                        <Border Background="{DynamicResource AmbarSuave}" CornerRadius="6" Padding="12,9" Margin="0,0,0,12">
                            <TextBlock Text="{Binding EstadoWeb}" Foreground="{DynamicResource Ambar}" TextWrapping="Wrap"/>
                        </Border>
                        <StackPanel Style="{StaticResource Campo}" Margin="0,0,0,12">
                            <TextBlock Text="Dirección de la tienda" Style="{StaticResource TxtEtiqueta}"/>
                            <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Campo}" Margin="0,0,0,6">
                            <TextBlock Text="Token de conexión" Style="{StaticResource TxtEtiqueta}"/>
                            <TextBox Text="{Binding Token, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" FontFamily="Consolas"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TokenTexto}" Style="{StaticResource TxtTenue}" Margin="0,0,0,12"/>
                        <Button Style="{StaticResource BtnPrimario}" Content="Guardar conexión" Command="{Binding GuardarWebCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <TextBlock Text="Respaldos" Style="{StaticResource TxtTitulo}"/>
                        <TextBlock Text="{Binding RespaldosTexto}" Style="{StaticResource TxtTenue}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding CarpetaRespaldos}" FontFamily="Consolas" FontSize="11.5" Foreground="{DynamicResource Texto2}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding Respaldos}" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock DockPanel.Dock="Left" Text="&#xE8C8;" FontFamily="{StaticResource Iconos}" FontSize="12" Foreground="{DynamicResource Texto3}"
                                                   Margin="0,2,8,0"/>
                                        <TextBlock Text="{Binding}" FontSize="12.5"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource BtnPrimario}" Content="Respaldar ahora" Command="{Binding RespaldarCommand}"/>
                            <Button Content="Abrir carpeta" Command="{Binding AbrirRespaldosCommand}"/>
                        </StackPanel>
                        <TextBlock Text="Para mayor seguridad, copia de vez en cuando un respaldo a una memoria USB o a la nube."
                                   Style="{StaticResource TxtTenue}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
