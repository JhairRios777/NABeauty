<UserControl x:Class="NABeauty.App.Vistas.RolesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Roles: lista a la izquierda; nombre y permisos (agrupados, incluidos los del panel web) a la derecha. -->
    <Grid Margin="28,22,28,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Lista ── -->
        <Border Style="{StaticResource Tarjeta}" Margin="0" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="18,14" BorderBrush="{DynamicResource Linea}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnChicoPrimario}" Margin="0" Command="{Binding NuevoCommand}" Content="Nuevo rol"/>
                        <TextBlock Text="Roles" Style="{StaticResource TxtSeccion}" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <ListBox Style="{StaticResource Lista}" Margin="10" ItemsSource="{Binding Lista}" SelectedItem="{Binding Seleccionado}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock x:Name="Candado" DockPanel.Dock="Right" Text="&#xE72E;" FontFamily="{StaticResource Iconos}" FontSize="12"
                                               Foreground="{DynamicResource Texto3}" VerticalAlignment="Center" Visibility="Collapsed" ToolTip="Rol del sistema"/>
                                    <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource TxtTenue}">
                                    <Run Text="{Binding PermisosTexto, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding UsuariosTexto, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Sistema}" Value="True">
                                    <Setter TargetName="Candado" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ── Formulario ── -->
        <Border Grid.Column="2" Style="{StaticResource Tarjeta}" Margin="0" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="20,16" BorderBrush="{DynamicResource Linea}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="{Binding TituloFormulario}" Style="{StaticResource TxtTitulo}" Margin="0,0,0,10"/>
                        <Grid IsEnabled="{Binding Editable}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Nombre" Style="{StaticResource TxtEtiqueta}"/>
                                <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" MaxLength="40"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Descripción" Style="{StaticResource TxtEtiqueta}"/>
                                <TextBox Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="El Administrador siempre tiene todos los permisos: no se edita ni se elimina."
                                   Style="{StaticResource TxtTenue}" Margin="0,8,0,0" Visibility="{Binding EsSistema, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" Padding="20,14" BorderBrush="{DynamicResource Linea}" BorderThickness="0,1,0,0" Background="{DynamicResource Superficie2}" CornerRadius="0,0,8,8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource BtnPeligro}" Content="Eliminar rol" Command="{Binding EliminarCommand}"
                                    Visibility="{Binding EsNuevo, Converter={StaticResource NoBoolVis}}"/>
                            <Button Style="{StaticResource BtnPrimario}" Content="Guardar rol" Command="{Binding GuardarCommand}" Margin="0"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Marcados}" FontWeight="SemiBold"/>
                            <TextBlock Text="Los cambios aplican en el próximo ingreso de cada usuario." Style="{StaticResource TxtTenue}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Grupos}" Margin="20,12,20,12" IsEnabled="{Binding Editable}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource LineaSuave}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,12,12">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource BtnEnlace}" Content="Todos / ninguno" FontSize="12" Margin="0"
                                                    Command="{Binding DataContext.TodosCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            <TextBlock Text="{Binding Nombre, Converter={StaticResource Mayusculas}}" FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{DynamicResource AcentoTinta}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding Permisos}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding Marcado}" Margin="0,4">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Nombre}" FontWeight="Medium"/>
                                                            <TextBlock Text="{Binding Detalle}" Style="{StaticResource TxtTenue}" FontSize="11.5"/>
                                                        </StackPanel>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
