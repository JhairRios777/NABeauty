<UserControl x:Class="NABeauty.App.Vistas.NuevaEntradaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Entrada nueva. Izquierda: buscar / escanear y tocar para agregar. Derecha: las líneas con
        cantidad y costo unitario (propuesto con el costo actual). Ctrl+S guarda.
    -->
    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding GuardarCommand}"/>
    </UserControl.InputBindings>

    <Grid Margin="28,20,28,22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Buscar productos ── -->
        <Border Style="{StaticResource Tarjeta}" Margin="0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBox x:Name="Buscador" Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged, Delay=150}" KeyDown="Buscador_KeyDown" Padding="32,6,9,6"/>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource Iconos}" FontSize="12" Foreground="{DynamicResource Texto3}"
                               VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False"/>
                    <TextBlock Text="Escanea o busca el producto" Foreground="{DynamicResource Texto3}" VerticalAlignment="Center" Margin="33,0,0,0"
                               IsHitTestVisible="False" Visibility="{Binding Texto, Converter={StaticResource NuloVis}, ConverterParameter=inv}"/>
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Resultados}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource BtnFila}" ToolTip="Agregar a la entrada"
                                        Command="{Binding DataContext.AgregarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="&#xE710;" FontFamily="{StaticResource Iconos}" FontSize="12"
                                                   Foreground="{DynamicResource AcentoTinta}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Insignia}" Tag="{Binding EstadoStock}" Padding="6,1">
                                            <TextBlock Text="{Binding Stock}"/>
                                        </Border>
                                        <ContentControl DockPanel.Dock="Left" Style="{StaticResource Miniatura}" Content="{Binding Foto}" Width="30" Height="30" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Nombre}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ── Entrada ── -->
        <Border Grid.Column="2" Style="{StaticResource Tarjeta}" Margin="0" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="20,16" BorderBrush="{DynamicResource Linea}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Proveedor (opcional)" Style="{StaticResource TxtEtiqueta}"/>
                            <TextBox Text="{Binding Proveedor, UpdateSourceTrigger=PropertyChanged}" MaxLength="120"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Nota o n.º de factura (opcional)" Style="{StaticResource TxtEtiqueta}"/>
                            <TextBox Text="{Binding Nota, UpdateSourceTrigger=PropertyChanged}" MaxLength="500"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border DockPanel.Dock="Bottom" Padding="20,14" BorderBrush="{DynamicResource Linea}" BorderThickness="0,1,0,0" Background="{DynamicResource Superficie2}" CornerRadius="0,0,8,8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Cancelar" Command="{Binding CancelarCommand}"/>
                            <Button Style="{StaticResource BtnPrimario}" Margin="0" Command="{Binding GuardarCommand}" ToolTip="Ctrl+S">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" FontFamily="{StaticResource Iconos}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Registrar entrada"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="COSTO TOTAL" Style="{StaticResource TxtMarca}" FontSize="17" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding Total}" FontFamily="{StaticResource FuenteNumeros}" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource AcentoTinta}"/>
                            </DockPanel>
                            <TextBlock Text="{Binding Unidades}" Style="{StaticResource TxtTenue}"/>
                            <CheckBox IsChecked="{Binding ActualizarCostos}" Margin="0,6,0,0">
                                <TextBlock Text="Usar estos costos como costo actual de cada producto"/>
                            </CheckBox>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid>
                    <StackPanel Margin="24,56" HorizontalAlignment="Center" Visibility="{Binding HayLineas, Converter={StaticResource NoBoolVis}}">
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource Iconos}" FontSize="30" Foreground="{DynamicResource Texto3}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Escanea o toca los productos que llegaron." Foreground="{DynamicResource Texto2}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HayLineas, Converter={StaticResource BoolVis}}">
                        <StackPanel Margin="20,10,20,10">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Producto" Style="{StaticResource TxtEtiqueta}"/>
                                <TextBlock Grid.Column="1" Text="Cantidad" Style="{StaticResource TxtEtiqueta}" Margin="8,0,0,5"/>
                                <TextBlock Grid.Column="2" Text="Costo unitario" Style="{StaticResource TxtEtiqueta}" Margin="8,0,0,5"/>
                                <TextBlock Grid.Column="3" Text="Subtotal" Style="{StaticResource TxtEtiqueta}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Lineas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource FilaLista}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="40"/>
                                                </Grid.ColumnDefinitions>
                                                <DockPanel VerticalAlignment="Center">
                                                    <ContentControl DockPanel.Dock="Left" Style="{StaticResource Miniatura}" Content="{Binding Articulo.Foto}" Width="32" Height="32" Margin="0,0,10,0"/>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding StockActual}" Style="{StaticResource TxtTenue}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                                <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right"/>
                                                <TextBox Grid.Column="2" Margin="8,0,0,0" Text="{Binding Costo, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Subtotal}" Style="{StaticResource TxtMonto}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                <Button Grid.Column="4" Style="{StaticResource BtnIcono}" Width="30" Height="30" FontSize="11" Content="&#xE711;" ToolTip="Quitar"
                                                        HorizontalAlignment="Right"
                                                        Command="{Binding DataContext.QuitarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
