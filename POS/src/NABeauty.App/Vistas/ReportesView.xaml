<UserControl x:Class="NABeauty.App.Vistas.ReportesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NABeauty.App.Controles">
    <!--
        Reportes. Todo sale de ReporteService.Generar: la pantalla, el Excel y el PDF muestran
        los mismos números. Gráfico de una sola serie en vino (por día o por mes).
    -->
    <UserControl.Resources>
        <!-- Fila con barra de participación (% del total) -->
        <DataTemplate x:Key="FilaParticipacion">
            <Border Style="{StaticResource FilaLista}" Padding="0,8">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding TotalTexto}" Style="{StaticResource TxtMonto}"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding PorcentajeTexto}" Foreground="{DynamicResource Texto3}" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <ProgressBar Value="{Binding Porcentaje, Mode=OneWay}" Height="5" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <Style x:Key="VacioReporte" TargetType="TextBlock" BasedOn="{StaticResource TxtTenue}">
            <Setter Property="Margin" Value="0,10,0,4"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,14,24">

            <!-- ── Período y exportar ── -->
            <DockPanel Margin="0,0,14,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"
                            Visibility="{Binding PuedeExportar, Converter={StaticResource BoolVis}}">
                    <Button Command="{Binding ExcelCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9F9;" FontFamily="{StaticResource Iconos}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Excel"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnPrimario}" Margin="0" Command="{Binding PdfCommand}"
                            ToolTip="Elige «Microsoft Print to PDF» en la impresora para guardarlo como PDF">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE749;" FontFamily="{StaticResource Iconos}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="PDF / Imprimir"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <c:SelectorPeriodoView DataContext="{Binding Periodo}" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding Subtitulo}" Style="{StaticResource TxtTenue}" Margin="2,8,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- ── Indicadores ── -->
            <ItemsControl ItemsSource="{Binding Kpis}" ItemTemplate="{StaticResource PlantillaKpi}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- ── Gráfico ── -->
            <Border Style="{StaticResource Tarjeta}" Margin="0,0,14,16">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding EntradasTexto}" Style="{StaticResource TxtTenue}" VerticalAlignment="Top" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding TituloGrafico}" Style="{StaticResource TxtTitulo}"/>
                    </DockPanel>
                    <Grid Height="220">
                        <ItemsControl ItemsSource="{Binding Barras}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="2,0" LastChildFill="False" Background="Transparent" ToolTip="{Binding Globo}">
                                        <TextBlock x:Name="Dia" DockPanel.Dock="Bottom" Text="{Binding Etiqueta}" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource Texto3}" FontSize="10.5" Margin="0,6,0,0"/>
                                        <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource LineaFuerte}" Margin="-2,0"/>
                                        <Border x:Name="Barra" DockPanel.Dock="Bottom" Height="{Binding Altura}" MaxWidth="34"
                                                CornerRadius="4,4,0,0" Background="{DynamicResource GradienteBarra}"/>
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding EsHoy}" Value="True">
                                            <Setter TargetName="Barra" Property="Background" Value="{DynamicResource BarraHoy}"/>
                                            <Setter TargetName="Dia" Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,24"
                                    Visibility="{Binding SinVentas, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource Iconos}" FontSize="24" Foreground="{DynamicResource Texto3}" HorizontalAlignment="Center"/>
                            <TextBlock Text="No hay ventas en este período." Foreground="{DynamicResource Texto2}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── Más vendidos + categorías ── -->
            <Grid Margin="0,0,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <TextBlock Text="Lo más vendido" Style="{StaticResource TxtTitulo}"/>
                        <DataGrid ItemsSource="{Binding Productos}" Style="{StaticResource TablaDetalle}" RowHeight="40">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PRODUCTO" Binding="{Binding Nombre}" Width="1.6*" ElementStyle="{StaticResource CeldaTexto}"/>
                                <DataGridTextColumn Header="OPCIÓN" Binding="{Binding Detalle}" Width="*" ElementStyle="{StaticResource CeldaTexto}"/>
                                <DataGridTextColumn Header="UNID." Binding="{Binding Unidades}" Width="70" ElementStyle="{StaticResource CeldaNum}"/>
                                <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalTexto}" Width="110" ElementStyle="{StaticResource CeldaNum}"/>
                                <DataGridTextColumn Header="%" Binding="{Binding PorcentajeTexto}" Width="64" ElementStyle="{StaticResource CeldaNum}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Sin ventas en el período." Style="{StaticResource VacioReporte}" Visibility="{Binding SinVentas, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <TextBlock Text="Por categoría" Style="{StaticResource TxtTitulo}"/>
                        <ItemsControl ItemsSource="{Binding Categorias}" ItemTemplate="{StaticResource FilaParticipacion}"/>
                        <TextBlock Text="Sin ventas en el período." Style="{StaticResource VacioReporte}" Visibility="{Binding SinVentas, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Métodos de pago + vendedoras ── -->
            <Grid Margin="0,0,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <TextBlock Text="Por método de pago" Style="{StaticResource TxtTitulo}"/>
                        <ItemsControl ItemsSource="{Binding Metodos}" ItemTemplate="{StaticResource FilaParticipacion}"/>
                        <TextBlock Text="Sin ventas en el período." Style="{StaticResource VacioReporte}" Visibility="{Binding SinVentas, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <TextBlock Text="Por vendedora" Style="{StaticResource TxtTitulo}"/>
                        <ItemsControl ItemsSource="{Binding Vendedoras}" ItemTemplate="{StaticResource FilaParticipacion}"/>
                        <TextBlock Text="Sin ventas en el período." Style="{StaticResource VacioReporte}" Visibility="{Binding SinVentas, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
