<UserControl x:Class="NABeauty.App.Vistas.CajaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewTextInput="Caja_PreviewTextInput">
    <!--
        Caja. Izquierda: búsqueda / escáner, pestañas por categoría y las opciones a la venta
        (miniatura pequeña de 48 px). Derecha: la venta en curso y el cobro.
        Teclado: escribir en cualquier parte va a la búsqueda (así el escáner siempre funciona),
        Enter agrega, Esc limpia, F12 cobra.
    -->
    <UserControl.InputBindings>
        <KeyBinding Key="F12" Command="{Binding CobrarCommand}"/>
    </UserControl.InputBindings>

    <Grid Margin="24,18,24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <!-- ═════════ Productos ═════════ -->
        <DockPanel Grid.Column="0">
            <!-- Búsqueda grande -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBox x:Name="Buscador" Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged, Delay=150}" KeyDown="Buscador_KeyDown"
                         FontSize="16" MinHeight="48" Padding="42,8,12,8"/>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource Iconos}" FontSize="16" Foreground="{DynamicResource Texto3}"
                           VerticalAlignment="Center" Margin="15,0,0,0" IsHitTestVisible="False"/>
                <TextBlock Text="Escanea el código o escribe nombre, tono o SKU…" FontSize="15" Foreground="{DynamicResource Texto3}"
                           VerticalAlignment="Center" Margin="43,0,0,0" IsHitTestVisible="False"
                           Visibility="{Binding Texto, Converter={StaticResource NuloVis}, ConverterParameter=inv}"/>
            </Grid>

            <!-- Pestañas por categoría -->
            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Filtros}" Margin="0,0,0,4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button x:Name="Chip" Style="{StaticResource BtnChip}" Focusable="False"
                                Command="{Binding DataContext.FiltroCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Punto" Style="{StaticResource PuntoColor}" Tag="{Binding Color}" Width="10" Height="10" Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding Nombre}"/>
                            </StackPanel>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Uuid}" Value="{x:Null}">
                                <Setter TargetName="Punto" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Activa}" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Acento}"/>
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Acento}"/>
                                <Setter TargetName="Chip" Property="Foreground" Value="{DynamicResource SobreAcento}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock DockPanel.Dock="Top" Text="{Binding ConteoResultados}" Style="{StaticResource TxtTenue}" Margin="2,0,0,10"
                       Visibility="{Binding HayResultados, Converter={StaticResource BoolVis}}"/>

            <!-- Vacío -->
            <StackPanel DockPanel.Dock="Top" Margin="20,50" HorizontalAlignment="Center" MaxWidth="420"
                        Visibility="{Binding HayResultados, Converter={StaticResource NoBoolVis}}">
                <TextBlock Text="&#xE7BF;" FontFamily="{StaticResource Iconos}" FontSize="32" Foreground="{DynamicResource AcentoTinta}" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding MensajeVacio}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0" Foreground="{DynamicResource Texto2}"/>
            </StackPanel>

            <!-- Opciones a la venta -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HayResultados, Converter={StaticResource BoolVis}}">
                <ItemsControl ItemsSource="{Binding Resultados}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button x:Name="Tarjeta" Style="{StaticResource BtnArticulo}" Width="232" Height="92" Click="Articulo_Click"
                                    Command="{Binding DataContext.AgregarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                    ToolTip="{Binding Nombre}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentControl Style="{StaticResource Miniatura}" Content="{Binding Foto}" Width="48" Height="48"
                                                    VerticalAlignment="Top" Margin="0,0,10,0"/>
                                    <DockPanel Grid.Column="1">
                                        <!-- Precio y stock abajo -->
                                        <DockPanel DockPanel.Dock="Bottom">
                                            <Border DockPanel.Dock="Right" Style="{StaticResource Insignia}" Tag="{Binding EstadoStock}" Padding="6,1">
                                                <TextBlock Text="{Binding StockTexto}" FontSize="10.5"/>
                                            </Border>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PrecioTexto}" Style="{StaticResource TxtMonto}" Foreground="{DynamicResource AcentoTinta}"/>
                                                <TextBlock Text="{Binding PrecioAntes}" FontSize="11" Foreground="{DynamicResource Texto3}" Margin="6,1,0,0"
                                                           TextDecorations="Strikethrough" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Producto}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel x:Name="LineaVariante" Orientation="Horizontal" Margin="0,2,0,0">
                                                <Border x:Name="PuntoTono" Style="{StaticResource PuntoColor}" Tag="{Binding ColorHex}" Width="10" Height="10" Margin="0,0,5,0"/>
                                                <TextBlock x:Name="TextoVariante" Text="{Binding Variante}" FontSize="12" Foreground="{DynamicResource Texto2}" TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                            </Button>
                            <DataTemplate.Triggers>
                                <!-- Sin opciones: en lugar de "Única" se muestra la marca -->
                                <DataTrigger Binding="{Binding Tipo}" Value="unica">
                                    <Setter TargetName="TextoVariante" Property="Text" Value="{Binding Marca}"/>
                                    <Setter TargetName="PuntoTono" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ColorHex}" Value="{x:Null}">
                                    <Setter TargetName="PuntoTono" Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Agotado}" Value="True">
                                    <Setter TargetName="Tarjeta" Property="Opacity" Value="0.55"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- ═════════ Venta en curso ═════════ -->
        <Border Grid.Column="2" Style="{StaticResource Tarjeta}" Margin="0" Padding="0">
            <DockPanel>
                <!-- Encabezado -->
                <Border DockPanel.Dock="Top" Padding="18,14" BorderBrush="{DynamicResource Linea}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnEnlace}" Content="Cancelar venta" Command="{Binding CancelarCommand}"
                                Visibility="{Binding CarritoVacio, Converter={StaticResource NoBoolVis}}"/>
                        <StackPanel>
                            <TextBlock Text="VENTA ACTUAL" Style="{StaticResource TxtMarca}" FontSize="20" Foreground="{DynamicResource AcentoTinta}"/>
                            <TextBlock Text="{Binding Unidades}" Style="{StaticResource TxtTenue}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Venta registrada -->
                <Border DockPanel.Dock="Top" Margin="14,12,14,0" Padding="14,12" CornerRadius="8" Background="{DynamicResource VerdeSuave}"
                        Visibility="{Binding HayUltimaVenta, Converter={StaticResource BoolVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnIcono}" Width="28" Height="28" FontSize="11" Content="&#xE711;"
                                Foreground="{DynamicResource Verde}" VerticalAlignment="Top" Command="{Binding CerrarAvisoCommand}" ToolTip="Cerrar"/>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" FontFamily="{StaticResource Iconos}" FontSize="18" Foreground="{DynamicResource Verde}"
                                   Margin="0,2,12,0" VerticalAlignment="Top"/>
                        <StackPanel>
                            <TextBlock Text="{Binding UltimaTitulo}" FontWeight="SemiBold" Foreground="{DynamicResource Verde}"/>
                            <TextBlock Text="{Binding UltimaDetalle}" FontSize="12.5" Foreground="{DynamicResource Verde}" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding UltimaCambio}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Verde}" Margin="0,4,0,0"
                                       Visibility="{Binding UltimaCambio, Converter={StaticResource NuloVis}}"/>
                            <Button Style="{StaticResource BtnChico}" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding ImprimirReciboCommand}" Focusable="False"
                                    Visibility="{Binding PuedeImprimir, Converter={StaticResource BoolVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE749;" FontFamily="{StaticResource Iconos}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Imprimir recibo"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Aviso (error o información) -->
                <!-- Ámbar = información; rojo = no se pudo (sin stock, efectivo insuficiente…) -->
                <Border DockPanel.Dock="Top" Margin="14,12,14,0" Padding="12,10" CornerRadius="8" BorderThickness="1"
                        Visibility="{Binding HayAviso, Converter={StaticResource BoolVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource AmbarSuave}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource AmbarBorde}"/>
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Ambar}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AvisoError}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource RojoSuave}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource RojoBorde}"/>
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource Rojo}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnIcono}" Width="24" Height="24" FontSize="10" Content="&#xE711;"
                                VerticalAlignment="Top" Command="{Binding CerrarAvisoCommand}" ToolTip="Cerrar"/>
                        <TextBlock Text="{Binding Aviso}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    </DockPanel>
                </Border>

                <!-- ── Cobro (abajo) ── -->
                <Border DockPanel.Dock="Bottom" Padding="18,14,18,18" BorderBrush="{DynamicResource Linea}" BorderThickness="0,1,0,0" Background="{DynamicResource Superficie2}"
                        CornerRadius="0,0,8,8">
                    <StackPanel>
                        <!-- Descuento -->
                        <DockPanel Margin="0,0,0,10">
                            <TextBox DockPanel.Dock="Right" Width="120" Text="{Binding Descuento, UpdateSourceTrigger=PropertyChanged, Delay=250}" TextAlignment="Right"
                                     MinHeight="32" Padding="8,4" IsEnabled="{Binding CarritoVacio, Converter={StaticResource Negar}}"/>
                            <TextBlock Text="Descuento (L)" VerticalAlignment="Center" Foreground="{DynamicResource Texto2}"/>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Subtotal}" Style="{StaticResource TxtMonto}"/>
                            <TextBlock Text="Subtotal" Foreground="{DynamicResource Texto2}"/>
                        </DockPanel>
                        <DockPanel Margin="0,4,0,0" Visibility="{Binding HayDescuento, Converter={StaticResource BoolVis}}">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding DescuentoAplicado}" Style="{StaticResource TxtMonto}" Foreground="{DynamicResource Verde}"/>
                            <TextBlock Text="Descuento" Foreground="{DynamicResource Texto2}"/>
                        </DockPanel>
                        <DockPanel Margin="0,8,0,12">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Total}" FontFamily="{StaticResource FuenteNumeros}" FontSize="28" FontWeight="Bold"
                                       Foreground="{DynamicResource AcentoTinta}"/>
                            <TextBlock Text="TOTAL" Style="{StaticResource TxtMarca}" FontSize="22" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- Método de pago -->
                        <ItemsControl ItemsSource="{Binding Metodos}" Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button x:Name="Metodo" Style="{StaticResource BtnChico}" Margin="0,0,6,0" Padding="4,7" Content="{Binding Nombre}" Focusable="False"
                                            Command="{Binding DataContext.MetodoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Clave}"/>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Activa}" Value="True">
                                            <Setter TargetName="Metodo" Property="Background" Value="{DynamicResource AcentoSuave}"/>
                                            <Setter TargetName="Metodo" Property="BorderBrush" Value="{DynamicResource Acento}"/>
                                            <Setter TargetName="Metodo" Property="Foreground" Value="{DynamicResource AcentoTinta}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Efectivo: recibido, montos rápidos y cambio -->
                        <StackPanel Visibility="{Binding EsEfectivo, Converter={StaticResource BoolVis}}" Margin="0,4,0,0">
                            <DockPanel Margin="0,0,0,6">
                                <TextBox x:Name="CampoRecibido" DockPanel.Dock="Right" Width="140" Text="{Binding Recibido, UpdateSourceTrigger=PropertyChanged}"
                                         TextAlignment="Right" FontSize="15" KeyDown="Recibido_KeyDown"
                                         IsEnabled="{Binding CarritoVacio, Converter={StaticResource Negar}}"/>
                                <TextBlock Text="Efectivo recibido (L)" VerticalAlignment="Center" Foreground="{DynamicResource Texto2}"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding MontosRapidos}" HorizontalAlignment="Right">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource BtnChico}" Margin="6,0,0,0" Content="{Binding Texto}" Focusable="False"
                                                Command="{Binding DataContext.MontoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Cambio}" Style="{StaticResource TxtMonto}" FontSize="18"/>
                                <TextBlock Text="Cambio" VerticalAlignment="Center" Foreground="{DynamicResource Texto2}"/>
                            </DockPanel>
                            <TextBlock Text="{Binding Falta}" Foreground="{DynamicResource Rojo}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,2,0,0"
                                       Visibility="{Binding HayFalta, Converter={StaticResource BoolVis}}"/>
                        </StackPanel>

                        <Button Style="{StaticResource BtnPrimario}" Margin="0,14,0,0" Padding="15,13" HorizontalAlignment="Stretch" Command="{Binding CobrarCommand}"
                                ToolTip="F12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8C7;" FontFamily="{StaticResource Iconos}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Cobrar " FontSize="16"/>
                                <TextBlock Text="{Binding Total}" FontSize="16" FontFamily="{StaticResource FuenteNumeros}"/>
                                <TextBlock Text="  ·  F12" FontSize="12" Opacity="0.75" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Carrito vacío -->
                <StackPanel DockPanel.Dock="Top" Margin="20,36" HorizontalAlignment="Center"
                            Visibility="{Binding CarritoVacio, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="&#xE7BF;" FontFamily="{StaticResource Iconos}" FontSize="28" Foreground="{DynamicResource Texto3}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Escanea o toca un producto para empezar" Foreground="{DynamicResource Texto2}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>

                <!-- Líneas -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding CarritoVacio, Converter={StaticResource NoBoolVis}}">
                    <ItemsControl ItemsSource="{Binding Lineas}" Margin="14,6,10,6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource FilaLista}" Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="74"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ContentControl Style="{StaticResource Miniatura}" Content="{Binding Articulo.Foto}" Width="34" Height="34" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Detalle}" FontSize="11.5" Foreground="{DynamicResource Texto3}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Unitario}" FontSize="11.5" Foreground="{DynamicResource Texto3}"/>
                                        </StackPanel>
                                        <!-- Cantidad -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                            <Button Style="{StaticResource BtnIcono}" Width="26" Height="26" FontSize="10" Content="&#xE738;" Focusable="False" ToolTip="Menos"
                                                    Command="{Binding DataContext.MenosCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            <TextBlock Text="{Binding Cantidad}" MinWidth="22" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                            <Button x:Name="Mas" Style="{StaticResource BtnIcono}" Width="26" Height="26" FontSize="10" Content="&#xE710;" Focusable="False" ToolTip="Más"
                                                    Command="{Binding DataContext.MasCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding Subtotal}" Style="{StaticResource TxtMonto}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <Button Grid.Column="4" Style="{StaticResource BtnIcono}" Width="26" Height="26" FontSize="10" Content="&#xE711;" Margin="6,0,0,0"
                                                Focusable="False" ToolTip="Quitar"
                                                Command="{Binding DataContext.QuitarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <!-- Llegó al stock disponible: el "+" se atenúa -->
                                    <DataTrigger Binding="{Binding AlTope}" Value="True">
                                        <Setter TargetName="Mas" Property="Opacity" Value="0.35"/>
                                        <Setter TargetName="Mas" Property="ToolTip" Value="No hay más en stock"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
