<UserControl x:Class="NABeauty.App.Vistas.ProductoEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Ficha de producto. Arriba: datos generales y fotos (miniaturas de 76 px).
        Abajo: las opciones (tonos, tallas…) con precio, oferta, costo, stock, SKU y código de barras.
        Sin permiso de gestionar productos, todo se ve deshabilitado (solo lectura).
        Ctrl+S guarda.
    -->
    <UserControl.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding GuardarCommand}"/>
    </UserControl.InputBindings>

    <DockPanel>
        <!-- ── Barra de acciones ── -->
        <Border DockPanel.Dock="Top" Padding="28,14" BorderBrush="{DynamicResource Linea}" BorderThickness="0,0,0,1" Background="{DynamicResource Superficie}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{Binding TextoArchivar}" Command="{Binding ArchivarCommand}"
                            Visibility="{Binding EsNuevo, Converter={StaticResource NoBoolVis}}"/>
                    <Button Content="Cancelar" Command="{Binding CancelarCommand}"/>
                    <Button Style="{StaticResource BtnPrimario}" Margin="0" Command="{Binding GuardarCommand}" ToolTip="Ctrl+S"
                            Visibility="{Binding PuedeEditar, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="{StaticResource Iconos}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Guardar"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Encabezado}" Style="{StaticResource TxtSeccion}" FontSize="17" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Solo lectura: tu rol puede ver productos pero no editarlos." Style="{StaticResource TxtTenue}"
                               Visibility="{Binding SoloLectura, Converter={StaticResource BoolVis}}"/>
                    <TextBlock Text="Archivado: no aparece en la caja ni en la tienda en línea." Foreground="{DynamicResource Ambar}" FontSize="12.5"
                               Visibility="{Binding Archivado, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel Margin="28,20,28,28">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="420"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="360"/>
                    </Grid.ColumnDefinitions>

                    <!-- ── Datos generales ── -->
                    <Border Grid.Column="0" Style="{StaticResource Tarjeta}">
                        <StackPanel IsEnabled="{Binding PuedeEditar}">
                            <TextBlock Text="Datos generales" Style="{StaticResource TxtTitulo}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Style="{StaticResource Campo}">
                                    <TextBlock Text="Nombre" Style="{StaticResource TxtEtiqueta}"/>
                                    <TextBox x:Name="CampoNombre" Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" MaxLength="120"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Style="{StaticResource Campo}" Margin="0,0,0,14">
                                    <TextBlock Text="Marca" Style="{StaticResource TxtEtiqueta}"/>
                                    <TextBox Text="{Binding Marca, UpdateSourceTrigger=PropertyChanged}" MaxLength="80"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Style="{StaticResource Campo}" Margin="0,0,0,14">
                                <TextBlock Text="Categoría" Style="{StaticResource TxtEtiqueta}"/>
                                <ComboBox ItemsSource="{Binding Categorias}" SelectedItem="{Binding Categoria}"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource Campo}" Margin="0,0,0,10">
                                <TextBlock Text="Descripción (se muestra en la tienda en línea)" Style="{StaticResource TxtEtiqueta}"/>
                                <TextBox Style="{StaticResource TxtMultilinea}" Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" Height="84"/>
                            </StackPanel>
                            <WrapPanel>
                                <CheckBox IsChecked="{Binding Temporada}" Margin="0,4,26,4">
                                    <TextBlock Text="De temporada (en la web solo se ve con stock)"/>
                                </CheckBox>
                                <CheckBox IsChecked="{Binding Destacado}" Margin="0,4,0,4">
                                    <TextBlock Text="Destacado en la tienda en línea"/>
                                </CheckBox>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── Fotos (miniaturas pequeñas) ── -->
                    <Border Grid.Column="2" Style="{StaticResource Tarjeta}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Style="{StaticResource BtnChico}" Margin="0" Command="{Binding AgregarFotosCommand}"
                                        Visibility="{Binding PuedeEditar, Converter={StaticResource BoolVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource Iconos}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Agregar fotos"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="Fotos" Style="{StaticResource TxtSeccion}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding TextoFotos}" Style="{StaticResource TxtTenue}" Margin="0,0,0,12"/>

                            <ItemsControl ItemsSource="{Binding Fotos}" Visibility="{Binding HayFotos, Converter={StaticResource BoolVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,10,10" Width="76">
                                            <Grid>
                                                <ContentControl x:Name="Mini" Style="{StaticResource Miniatura}" Content="{Binding Ruta}" Width="76" Height="76"/>
                                                <!-- Sello: principal (vino) o nueva (pendiente de subir) -->
                                                <Border x:Name="Sello" CornerRadius="0,5,0,5" Padding="6,1" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Background="{DynamicResource Acento}" Visibility="Collapsed">
                                                    <TextBlock x:Name="SelloTexto" Text="Principal" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SobreAcento}"/>
                                                </Border>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0"
                                                        Visibility="{Binding DataContext.PuedeEditar, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}}">
                                                <Button x:Name="BtnPrincipal" Style="{StaticResource BtnIcono}" Width="28" Height="26" FontSize="12" Content="&#xE734;"
                                                        ToolTip="Usar como principal"
                                                        Command="{Binding DataContext.PrincipalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource BtnIcono}" Width="28" Height="26" FontSize="12" Content="&#xE74D;" ToolTip="Quitar foto"
                                                        Command="{Binding DataContext.QuitarFotoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Principal}" Value="True">
                                                <Setter TargetName="Sello" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="BtnPrincipal" Property="Content" Value="&#xE735;"/>
                                                <Setter TargetName="BtnPrincipal" Property="Foreground" Value="{DynamicResource AcentoTinta}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Pendiente}" Value="True">
                                                <Setter TargetName="Sello" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="Sello" Property="Background" Value="{DynamicResource AmbarSuave}"/>
                                                <Setter TargetName="SelloTexto" Property="Text" Value="Nueva"/>
                                                <Setter TargetName="SelloTexto" Property="Foreground" Value="{DynamicResource Ambar}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Sin fotos -->
                            <Border BorderBrush="{DynamicResource LineaFuerte}" BorderThickness="1" CornerRadius="8" Padding="16,18"
                                    Background="{DynamicResource Superficie2}" Visibility="{Binding HayFotos, Converter={StaticResource NoBoolVis}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE91B;" FontFamily="{StaticResource Iconos}" FontSize="22" Foreground="{DynamicResource Texto3}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Sin fotos todavía" Foreground="{DynamicResource Texto2}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── Opciones: precio, stock y códigos ── -->
                <Border Style="{StaticResource Tarjeta}" Margin="0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" IsEnabled="{Binding PuedeEditar}">
                                <TextBlock Text="Tipo" Style="{StaticResource TxtEtiqueta}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Width="160" ItemsSource="{Binding Tipos}" SelectedItem="{Binding Tipo}" Margin="0,0,10,0"/>
                                <Button Style="{StaticResource BtnChico}" Margin="0" Command="{Binding AgregarVarianteCommand}"
                                        Visibility="{Binding EsUnica, Converter={StaticResource NoBoolVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource Iconos}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Agregar"/>
                                        <TextBlock Text=" "/>
                                        <TextBlock Text="{Binding EtiquetaOpcion}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Precio y stock" Style="{StaticResource TxtSeccion}"/>
                                <TextBlock Style="{StaticResource TxtTenue}"
                                           Text="Montos en lempiras. El stock de lo ya guardado solo cambia con entradas, ventas o ajustes."/>
                            </StackPanel>
                        </DockPanel>

                        <!-- Encabezados (mismos anchos que las filas) -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Width="38" Visibility="{Binding ConColor, Converter={StaticResource BoolVis}}"/>
                            <TextBlock Width="200" Margin="0,0,8,0" Text="{Binding EtiquetaOpcion}" Style="{StaticResource TxtEtiqueta}"
                                       Visibility="{Binding EsUnica, Converter={StaticResource NoBoolVis}}"/>
                            <TextBlock Width="104" Margin="0,0,8,0" Text="Precio" Style="{StaticResource TxtEtiqueta}"/>
                            <TextBlock Width="104" Margin="0,0,8,0" Text="Oferta" Style="{StaticResource TxtEtiqueta}"/>
                            <TextBlock Width="104" Margin="0,0,8,0" Text="Costo" Style="{StaticResource TxtEtiqueta}"
                                       Visibility="{Binding VerCostos, Converter={StaticResource BoolVis}}"/>
                            <TextBlock Width="110" Margin="0,0,8,0" Text="Stock" Style="{StaticResource TxtEtiqueta}"/>
                            <TextBlock Width="130" Margin="0,0,8,0" Text="SKU" Style="{StaticResource TxtEtiqueta}"/>
                            <TextBlock Width="150" Margin="0,0,8,0" Text="Código de barras" Style="{StaticResource TxtEtiqueta}"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding Variantes}" IsEnabled="{Binding PuedeEditar}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource LineaSuave}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Color del tono: muestra + campo #RRGGBB en el globo -->
                                            <Border Width="30" Height="30" CornerRadius="15" Margin="0,0,8,0" BorderThickness="1" BorderBrush="{DynamicResource LineaFuerte}"
                                                    Background="{Binding ColorHex, Converter={StaticResource ColorHex}}" ToolTip="Color del tono (#RRGGBB)"
                                                    Visibility="{Binding DataContext.ConColor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}}"/>
                                            <StackPanel Width="200" Margin="0,0,8,0"
                                                        Visibility="{Binding DataContext.EsUnica, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NoBoolVis}}">
                                                <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" MaxLength="60"/>
                                                <TextBox Text="{Binding ColorHex, UpdateSourceTrigger=PropertyChanged}" MaxLength="7" Margin="0,4,0,0" FontSize="12" MinHeight="28" Padding="8,3"
                                                         ToolTip="Color del tono en formato #RRGGBB (opcional)"
                                                         Visibility="{Binding DataContext.ConColor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}}"/>
                                            </StackPanel>
                                            <TextBox Width="104" Margin="0,0,8,0" VerticalAlignment="Top" Text="{Binding Precio, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right"/>
                                            <TextBox Width="104" Margin="0,0,8,0" VerticalAlignment="Top" Text="{Binding Oferta, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right"
                                                     ToolTip="Opcional: menor que el precio"/>
                                            <TextBox Width="104" Margin="0,0,8,0" VerticalAlignment="Top" Text="{Binding Costo, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right"
                                                     Visibility="{Binding DataContext.VerCostos, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}}"/>
                                            <!-- Stock: nueva = stock inicial editable; guardada = stock actual -->
                                            <Grid Width="110" Margin="0,0,8,0" VerticalAlignment="Top">
                                                <TextBox Text="{Binding StockInicial, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" ToolTip="Unidades que ya hay en tienda"
                                                         Visibility="{Binding EsNueva, Converter={StaticResource BoolVis}}"/>
                                                <TextBlock Text="{Binding StockTexto}" VerticalAlignment="Center" Margin="2,9,0,0" FontWeight="SemiBold"
                                                           Visibility="{Binding EsNueva, Converter={StaticResource NoBoolVis}}"/>
                                            </Grid>
                                            <TextBox Width="130" Margin="0,0,8,0" VerticalAlignment="Top" Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" MaxLength="40"
                                                     CharacterCasing="Upper"/>
                                            <TextBox Width="150" Margin="0,0,8,0" VerticalAlignment="Top" Text="{Binding Codigo, UpdateSourceTrigger=PropertyChanged}" MaxLength="40"
                                                     ToolTip="Escanéalo aquí con el lector"/>
                                            <CheckBox IsChecked="{Binding Activa}" VerticalAlignment="Top" Margin="2,9,10,0" ToolTip="Desactivada: no se vende ni se muestra">
                                                <TextBlock Text="Activa"/>
                                            </CheckBox>
                                            <Button Style="{StaticResource BtnIcono}" Width="32" Height="32" FontSize="13" Content="&#xE74D;" VerticalAlignment="Top"
                                                    ToolTip="Quitar" Command="{Binding DataContext.QuitarVarianteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding SePuedeQuitar, Converter={StaticResource BoolVis}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource TxtTenue}" Margin="0,12,0,0"
                                   Text="Stock inicial: lo que ya tienes en tienda al crear la opción. Lo que llegue después se registra en Entradas."
                                   Visibility="{Binding PuedeStockInicial, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
