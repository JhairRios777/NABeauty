<UserControl x:Class="NABeauty.App.Vistas.UsuariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Usuarios: lista a la izquierda, formulario a la derecha. La contraseña temporal se muestra una vez. -->
    <Grid Margin="28,22,28,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- ── Lista ── -->
        <Border Style="{StaticResource Tarjeta}" Margin="0" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="20,16" BorderBrush="{DynamicResource Linea}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimario}" Margin="0" Command="{Binding NuevoCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8FA;" FontFamily="{StaticResource Iconos}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Nuevo usuario"/>
                            </StackPanel>
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Usuarios" Style="{StaticResource TxtSeccion}"/>
                            <TextBlock Text="{Binding Conteo}" Style="{StaticResource TxtTenue}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <ListBox Style="{StaticResource Lista}" Margin="10" ItemsSource="{Binding Lista}" SelectedItem="{Binding Seleccionado}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AcentoSuave}" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Iniciales}" Foreground="{DynamicResource AcentoTinta}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Style="{StaticResource TxtTenue}">
                                        <Run Text="{Binding UsuarioLogin, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding RolNombre, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource Insignia}" Tag="{Binding Estado}">
                                    <TextBlock Text="{Binding EstadoTexto}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ── Formulario ── -->
        <StackPanel Grid.Column="2">
            <!-- Contraseña temporal recién creada -->
            <Border Background="{DynamicResource VerdeSuave}" CornerRadius="8" Padding="16,14" Margin="0,0,0,14"
                    Visibility="{Binding HayClaveTemporal, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource BtnIcono}" Width="26" Height="26" FontSize="10" Content="&#xE711;"
                                Foreground="{DynamicResource Verde}" Command="{Binding CerrarTemporalCommand}" ToolTip="Ya la anoté"/>
                        <TextBlock Text="{Binding ClaveTemporalPara}" Foreground="{DynamicResource Verde}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    </DockPanel>
                    <TextBox Text="{Binding ClaveTemporal, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="20" FontWeight="Bold"
                             HorizontalContentAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock Text="No se vuelve a mostrar. Si se pierde, usa «Restablecer contraseña»." Foreground="{DynamicResource Verde}" FontSize="12" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Tarjeta}" Margin="0">
                <StackPanel>
                    <TextBlock Text="{Binding TituloFormulario}" Style="{StaticResource TxtTitulo}" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Style="{StaticResource Campo}" Margin="0,0,0,14">
                        <TextBlock Text="Nombre completo" Style="{StaticResource TxtEtiqueta}"/>
                        <TextBox Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" MaxLength="80"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Campo}" Margin="0,0,0,14">
                        <TextBlock Text="Usuario (para entrar)" Style="{StaticResource TxtEtiqueta}"/>
                        <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" CharacterCasing="Lower"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Campo}" Margin="0,0,0,14">
                        <TextBlock Text="Rol" Style="{StaticResource TxtEtiqueta}"/>
                        <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Rol}"/>
                    </StackPanel>
                    <CheckBox IsChecked="{Binding Activo}" Margin="0,0,0,4" Visibility="{Binding EsNuevo, Converter={StaticResource NoBoolVis}}">
                        <TextBlock Text="Activo (puede entrar al POS y al panel web)"/>
                    </CheckBox>
                    <TextBlock Text="{Binding UltimoAcceso}" Style="{StaticResource TxtTenue}" Margin="0,4,0,16"/>

                    <Button Style="{StaticResource BtnPrimario}" Content="{Binding TextoBoton}" Command="{Binding GuardarCommand}" Margin="0" Padding="15,10" HorizontalAlignment="Stretch"/>
                    <TextBlock Text="Al crear el usuario se genera una contraseña temporal: la persona la cambia al entrar."
                               Style="{StaticResource TxtTenue}" Margin="0,8,0,0" Visibility="{Binding EsNuevo, Converter={StaticResource BoolVis}}"/>

                    <StackPanel Margin="0,16,0,0" Visibility="{Binding EsNuevo, Converter={StaticResource NoBoolVis}}">
                        <Border Style="{StaticResource Separador}" Margin="0,0,0,14"/>
                        <Button Content="Restablecer contraseña" Command="{Binding RestablecerCommand}" Margin="0" HorizontalAlignment="Stretch"/>
                        <Button Content="Desbloquear acceso" Command="{Binding DesbloquearCommand}" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                Visibility="{Binding Bloqueado, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Text="Bloqueado por demasiados intentos fallidos." Foreground="{DynamicResource Rojo}" FontSize="12.5" Margin="0,6,0,0"
                                   Visibility="{Binding Bloqueado, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
